QUOTE_SENDER_MAILBOX=
# Optional verified internal column names if master labels differ from Document Key / Status.
QUOTE_MASTER_KEY_COLUMN=
QUOTE_MASTER_STATUS_COLUMN=
# Verified Client Operations text column populated from Create Working Copy instanceRef.
# If blank, connection check resolves a unique Instance Reference / Instance Ref display name.
QUOTE_INSTANCE_REF_COLUMN=
