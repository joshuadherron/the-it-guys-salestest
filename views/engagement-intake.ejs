<%- include('header') %><h1><%= engagementTypes[p.engagement_type] %> intake</h1><p><a href="/prospects/<%= p.id %>/work"><%= p.business_name %> · <%= p.opp %></a></p>
<p><a href="/prospects/<%= p.id %>/discovery-history">Discovery history</a></p><%- include('prior-discovery',{discoveryAnswers:answers}) %>
<% if(error){ %><p class="error"><%= error %></p><% } %><% if(p.hold){ %><p class="hold">On Hold — Pending Josh Review. Resolve the concern before completing intake or approving work.</p><% } %>
<% if(missing.length){ %><section class="card"><h2>Required questions</h2><ul><% for(const field of missing){ %><li><a href="<%= field.href %>"><%= field.label %></a></li><% } %></ul></section><% } %>
<form method="post" class="card" action="/prospects/<%= p.id %>/intake"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= revision %>">
<% for(const [key,label] of intakeFields){ const relevant=p.engagement_type==='hourly'?['contact','issue','scope','access','rate_authorization']:['contact','issue','scope','deliverables','dependencies','schedule','authorization']; if(!relevant.includes(key))continue; %><label id="intake-<%= key %>"><%= label %><textarea name="<%= key %>" maxlength="4000" rows="3"><%= answers[key]||'' %></textarea></label><% } %>
<fieldset><legend>Security and access concerns</legend><% for(const [key,label] of riskFields){ %><label><input type="checkbox" name="<%= key %>" value="yes" <%= answers[key]?'checked':'' %>><%= label %></label><% } %><p>An urgent security concern places the opportunity on hold. Record access, regulated-data and backup dependencies before work is authorized.</p></fieldset>
<button>Save draft intake</button><button name="complete" value="yes">Complete intake</button></form>
<% if(user.role==='owner'&&p.hold){ %><section class="card"><h2>Review urgent hold</h2><p>Document the review, then update the intake to reflect the resolved security concern before completing it.</p><form method="post" action="/prospects/<%= p.id %>/intake/release-hold"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Review / resolution note<textarea name="note" minlength="10" maxlength="1000" required></textarea></label><button>Release hold after review</button></form></section><% } %><%- include('footer') %>
