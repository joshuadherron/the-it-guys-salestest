<section class="card" aria-label="Quote Send status">
<% const active=['Queued','Prepared','Sending'].includes(job.status),options=typeof job.options_json==='string'?JSON.parse(job.options_json):job.options_json||{}; %>
<h2><%= active?'In progress':({ReadySignature:'Ready for signature',Failed:'Failed',WaitingApproval:'Waiting for Josh',Dryrun:'Test email sent'})[job.status]||job.status %></h2>
<% if(active){ %><p><%= ({record_requested:'Setting up client folder',record_ready:'Creating quote copy',copy_requested:'Creating quote copy',copy_waiting:'Waiting for SharePoint to finish the copy…',psa_waiting:'Waiting for SharePoint to finish the copy…',psa_requested:'Preparing PSA copy',copy_ready:'Filling quote',filled:'Sending'})[options._step]||'Preparing / sending quote' %></p><a href="/quick-quote/quotes/<%= q.id||job.quote_id %>/progress">View progress</a><% } %>
<% if(job.status==='Failed'){ %><p class="error"><%= job.error_message %></p><%- include('quick-send-retry',{q,job}) %><p><a href="/quotes/<%= q.id||job.quote_id %>/delivery">Email delivery history / reconciliation</a>. An uncertain email is never replayed by Try again.</p><% } %>
<% if(job.status==='ReadySignature'){ %><a href="/quick-quote/quotes/<%= q.id||job.quote_id %>/progress">Open signature documents</a><% } %>
</section>
