<%- include('header') %>
<p>
<a href="/prospects/<%= p.id %>">
<%= p.opp %> · <%= p.business_name %>
</a>
</p>
<h1>
<%= screens[screen-1] %>
</h1>
<p>Section <%= screen %> of 3 · <%= d.status %> · Internal only</p>
<div class="no-print">
<nav class="screen-nav">
<% for(const [i,name] of screens.entries()){ %>
<a class="<%= i+1===screen?'active':'' %>" href="/prospects/<%= p.id %>/discovery/<%= i+1 %>">
<%= i+1 %>. <%= name %>
</a>
<% } %>
</nav>
</div>
<p id="required-progress"><%= progress.complete %> of <%= progress.total %> required items complete</p>
<p>Missing required groups:</p>
<ul id="missing-groups"><% for(const group of missing){ %><li><%= group %></li><% } %></ul>
<div id="urgent-guidance" class="hold" <%= p.hold?'':'hidden' %>>
<h2>URGENT SECURITY REVIEW</h2>
<strong>On Hold — Pending Josh Review</strong>
<p>No diagnosing, no reassurance about severity, no speculation. Record what was said, thank the customer, tell them “someone will follow up on that specifically and quickly”, and keep gathering MVD fields only if the customer is comfortable.</p>
<p>No scheduling, pricing or timeline talk until Josh releases it.</p>
<% if(user.role==='owner'){ %>
<form method="post" action="/prospects/<%= p.id %>/discovery/release">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Release note</label>
<textarea name="note" required>
</textarea>
<button>Release hold</button>
</form>
<% } %>
</div>
<% for(const n of notifications){ %>
<p class="pill">
<%= n.kind %>: <%= n.status %>
</p>
<% } %>
<p id="save-status" role="status" aria-live="polite">
<%= readonly?'Read-only. Josh can reopen this discovery.':'Changes save automatically. Not discussed means the question was not reached.' %>
</p>
<div id="discovery" data-id="<%= p.id %>" data-revision="<%= d.revision %>">
<% for(const q of schema.filter(q=>sectionFor(q)===screen)){const cell=d.answers[q.id];const v=cell?.value;const state=cell?.state||'not_discussed';const selected=q.follow?v?.answer:v;const visible=!q.condition||q.condition.values.includes(answer(d.answers,q.condition.id)); %>
<fieldset class="question" data-question="<%= q.id %>" data-type="<%= q.type %>" data-follow="<%= q.follow?.when||'' %>" <%= readonly?'disabled':'' %> <%= visible?'':'hidden' %>>
<legend>
<%= q.id %> <%= q.label %>
</legend>
<p>
<%= q.prompt %>
</p>
<% if(q.helper){ %>
<p class="muted">
<%= q.helper %>
</p>
<% } %>
<small>
<%= q.required?'MVD REQUIRED':'DISCOVERY OPTIONAL' %>
</small>
<details>
<summary>Question guidance</summary>
<p>
<%= q.wording %>
</p>
</details>
<details class="answer-status-control">
<summary>Change status</summary>
<label>Answer state</label>
<select class="answer-state">
<option value="not_discussed" <%= state==='not_discussed'?'selected':'' %>>Not discussed</option>
<option value="not_sure" <%= state==='not_sure'?'selected':'' %>>Not sure</option>
<option value="answered" <%= state==='answered'?'selected':'' %>>Answered</option>
</select>
</details>
<div class="answer-fields">
<% if(q.type==='select'){ %>
<label>
<%= q.label %>
</label>
<select class="answer-value">
<option value="">Choose…</option>
<% for(const o of q.options){ %>
<option value="<%= o %>" <%= selected===o?'selected':'' %>>
<%= o %>
</option>
<% } %>
</select>
<% }else if(q.type==='multi'){ %>
<div class="choices">
<% for(const o of q.options){ %>
<label>
<input type="checkbox" class="answer-choice" value="<%= o %>" <%= Array.isArray(v)&&v.includes(o)?'checked':'' %>> <%= o %>
</label>
<% } %>
</div>
<% }else if(q.type==='matrix'){for(const [row,label] of [['domain','Business email domain'],['admin','Microsoft 365 / email admin account']]){const cell=v?.[row]; %>
<label>
<%= label %>
</label>
<select class="matrix-value" data-row="<%= row %>">
<option value="not_discussed" <%= !cell||cell.state==='not_discussed'?'selected':'' %>>Not discussed</option>
<option value="not_sure" <%= cell?.state==='not_sure'?'selected':'' %>>Not sure</option>
<% for(const o of (row==='domain'?ownership:ownership.slice(0,3))){ %>
<option value="<%= o %>" <%= cell?.value===o?'selected':'' %>>
<%= o %>
</option>
<% } %>
</select>
<% }}else if(q.type==='apps'){ %>
<label>
<input type="checkbox" class="apps-none" <%= v?.none?'checked':'' %>> None that I can think of</label>
<div class="app-entries">
<% for(const entry of v?.entries?.length?v.entries:[{name:'',use:'',hosting:'Not discussed'}]){ %>
<div class="app-entry card">
<label>application name</label>
<input class="app-name" value="<%= entry.name %>">
<label>what it's used for</label>
<input class="app-use" value="<%= entry.use %>">
<label>Cloud-based / Installed on computers or a server / Not sure</label>
<select class="app-hosting">
<% for(const o of ['Not discussed','Cloud-based','Installed on computers or a server','Not sure']){ %>
<option <%= entry.hosting===o?'selected':'' %>>
<%= o %>
</option>
<% } %>
</select>
<button type="button" class="remove-app secondary">Remove entry</button>
</div>
<% } %>
</div>
<button type="button" class="add-app secondary">Add application</button>
<% }else if(q.type==='volume'){ %>
<label>Approximate data volume</label>
<input type="number" min="0" class="volume-amount" value="<%= v?.amount??'' %>">
<select class="volume-unit">
<option <%= v?.unit==='GB'?'selected':'' %>>GB</option>
<option <%= v?.unit==='TB'?'selected':'' %>>TB</option>
</select>
<% }else if(q.type==='billing'){ %>
<label>
<input type="checkbox" class="billing-same" <%= v?.same?'checked':'' %>> Billing contact same as approver</label>
<input class="answer-value" value="<%= v?.answer||'' %>">
<% }else{ %>
<label>
<%= q.label %>
</label>
<input type="<%= q.type %>" class="answer-value" min="0" value="<%= v??'' %>">
<% }if(q.follow){ %>
<div class="follow-fields" <%= selected===q.follow.when?'':'hidden' %>>
<label>
<%= q.follow.label %>
</label>
<% if(q.follow.type==='devices'){ %>
<select class="follow-value">
<option value="">Choose…</option>
<% for(const o of ['phones','computers','both']){ %>
<option <%= v?.detail===o?'selected':'' %>>
<%= o %>
</option>
<% } %>
</select>
<% }else{ %>
<input class="follow-value" type="<%= q.follow.type==='number'?'number':'text' %>" min="0" value="<%= v?.detail??'' %>">
<% } %>
</div>
<% } %>
</div>
<p class="question-status" role="status">
<%= state==='answered'?'Answered':state==='not_sure'?'Not sure':'Not discussed' %>
</p>
</fieldset>
<% } if(screen===3){ %>
<details><summary>Review saved discovery</summary>
<%- include('summary',{p,d,schema,format,majorFlagOrder}) %>
</details>
<section class="card">
<h2>Minimum viable discovery</h2>
<form method="post" action="/prospects/<%= p.id %>/discovery/send">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button id="send-discovery" data-locked="<%= d.status==='Ready for Review' %>" <%= missing.length||p.hold||d.status==='Ready for Review'?'disabled':'' %>>Send to Josh</button>
</form>
<% if(user.role==='owner'&&d.status==='Ready for Review'){ %>
<form method="post" action="/prospects/<%= p.id %>/discovery/reopen">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button class="secondary">Reopen discovery</button>
</form>
<% } %>
</section>
<% } %>
</div>
<div class="row no-print">
<% if(screen>1){ %>
<a class="button secondary" href="/prospects/<%= p.id %>/discovery/<%= screen-1 %>">Back</a>
<% }if(screen<3){ %>
<a class="button" href="/prospects/<%= p.id %>/discovery/<%= screen+1 %>">Continue</a>
<% } %>
</div>
<%- include('footer') %>