<%- include('header') %>
<% if(p.business_id){ %><p><a href="/businesses/<%= p.business_id %>">Business and all opportunities</a> · <a href="/prospects/new?business_id=<%= p.business_id %>">New opportunity for this business</a></p><% } %>
<p class="muted">
BUSINESS RECORD · <%= p.opp %> · <%= p.stage %>
</p>
<h1>
<%= p.business_name %>
</h1>
<% if(user.is_admin===true||user.is_admin===1){ %><p class="no-print"><a href="/prospects/<%= p.id %>/delete">Delete prospect</a></p><% } %>
<% if(p.switch_review_new){ %><span class="pill">New lead</span><% } %>
<% if(p.source){ %><span class="pill"><%= p.source %><%= p.employee_range ? " · Staff: "+p.employee_range : "" %></span><% } %>
<p>
<%= p.contact_name %> · <a href="tel:<%= p.phone %>"><%= p.phone %></a> · <%= p.email %>
</p>
<% if(p.street_address||p.city||p.state||p.zip){ %>
<p>
<%= p.street_address||'' %><% if(p.street_address&&(p.city||p.state||p.zip)){ %><br><% } %>
<%= p.city||'' %><%= p.city&&p.state?', ':'' %><%= p.state||'' %><%= p.zip?' '+p.zip:'' %>
</p>
<% } %>
<%- include('sales-actions') %><%- include('sales-outcome') %>
<details class="card"><summary>SharePoint synchronization · technical details</summary>
<% if(sync){ %>
<p>Latest sync: <strong><%= sync.status %></strong> · <%= sync.created_at %></p>
<% if(sync.result_message){ %><p class="error"><%= sync.result_message %></p><% } %>
<% }else{ %>
<p>No prospect sync has been attempted yet.</p>
<% } %>
<form method="post" action="/prospects/<%= p.id %>/sync">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button class="secondary">Sync prospect to SharePoint</button>
</form>
</details>
<section class="card"><h2>Customer relationship</h2><p><%= relationshipLabel(p) %></p><% if(typeof servicePlan!=='undefined'&&servicePlan.services.length){ %><p>Planned services: <%= servicePlan.services.join(' + ') %></p><p>Starting workflow: <%= servicePlan.startingLane %></p><% if(servicePlan.reason){ %><p>Timing exception: <%= servicePlan.reason %></p><% } %><% } %><% if(user.role==='owner'){ %><a href="/prospects/<%= p.id %>/relationship">Customer relationship / Link existing client</a><% } %></section>
<details class="card"><summary>Workflow guidance and operational steps</summary><div data-workflow-panel="<%= p.id %>"><%- include('workflow-panel') %></div></details>
<div class="row no-print">
<a class="button" href="/prospects/<%= p.id %>/<%= p.relationship_type==='existing_client'?'additional-discovery' :'discovery/resume' %>"><%= p.relationship_type==='existing_client'?'Additional Service Discovery':'Business discovery' %></a>
<a class="button secondary" href="/prospects/<%= p.id %>/quotes">BII worksheet</a>
<a class="button secondary" href="/prospects/<%= p.id %>/handoff">SharePoint actions &amp; history</a>
<a href="/prospects/<%= p.id %>/edit">Edit prospect</a>
</div>
<section class="card">
<h2>Prospect notes</h2>
<p>Follow-up: <%= p.follow_up||'Not scheduled' %> · Owner: <%= p.owner %>
</p>
<p>Likely Service: <%= p.likely_service||'Unset' %> — commercial interest; workflow lane is separate.</p>
<p>Workflow lane: <%= p.service_lane||'Unset' %></p>
<p>
<%= p.notes %>
</p>

</section>
<section class="card"><h2>Next action, meeting & migration details</h2>
<% for(const [key,label] of structuredFields){if(p[key]!==null&&p[key]!==undefined&&p[key]!==''){ %><p class="preserve-lines"><strong><%= label %>:</strong> <%= ['teams_scheduled','josh_needed'].includes(key)?(p[key]?'Yes':'No'):p[key] %></p><% }} %>
<% if(p.legacy_stage){ %><p>Original source stage: <%= p.legacy_stage %></p><% } %>
<% if(p.import_source){ %><p>Import source: <%= p.import_source %></p><% } %>
<% if(p.likely_tier&&p.likely_tier!=='Not sure'){ %><p>Historical tier (source only): <%= p.likely_tier %>. Not a current service offering.</p><% } %>
</section>
<% for(const n of notifications){ %>
<p class="pill">
<%= n.kind %>: <%= n.status %>
</p>
<% } %>
<section class="card" id="sales-notes">
<h2>Log a conversation or note</h2>
<form method="post" action="/prospects/<%= p.id %>/activities">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="grid">
<div>
<label>Type</label>
<select name="type">
<% for(const t of ['call','visit','email','note']){ %>
<option>
<%= t %>
</option>
<% } %>
</select>
</div>
<div>
<label>Outcome</label>
<select name="outcome">
<% for(const o of outcomes){ %>
<option>
<%= o %>
</option>
<% } %>
</select>
</div>
<div>
<label>Date</label>
<input type="date" name="occurred_on" value="<%= new Date().toISOString().slice(0,10) %>">
</div>
</div>
<label>Notes</label>
<textarea name="notes">
</textarea>
<button>Log activity</button>
</form>
</section>
<section class="card">
<h2>Activity history</h2>
<% for(const a of activities){ %>
<p>
<strong>
<%= a.occurred_on %> · <%= a.type %> · <%= a.outcome %>
</strong>
<br>
<%= a.notes %>
</p>
<% } %>
</section>
<%- include('footer') %>
