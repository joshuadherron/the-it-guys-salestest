<%- include('header') %><p class="muted"><%= p.opp %> · <%= p.stage %></p><h1><%= p.business_name %></h1><p><%= p.contact_name %> · <a href="tel:<%= p.phone %>"><%= p.phone %></a> · <%= p.email %></p><% if(p.hold){ %><div class="hold"><h2>On Hold — Pending Josh Review</h2><p>No scheduling, pricing or timeline talk until Josh releases this hold.</p></div><% } %><div class="row no-print"><a class="button" href="/prospects/<%= p.id %>/discovery/1">Business discovery</a><a class="button secondary" href="/prospects/<%= p.id %>/quotes">BII worksheet</a><a class="button secondary" href="/prospects/<%= p.id %>/handoff">SharePoint handoff</a><a href="/prospects/<%= p.id %>/edit">Edit prospect</a></div><section class="card"><h2>Next step</h2><p>Follow-up: <%= p.follow_up||'Not scheduled' %> · Owner: <%= p.owner %></p><p>Likely tier: <%= p.likely_tier %> — signal for Josh, not a decision.</p><p><%= p.notes %></p><div data-client-status="<%= p.id %>"><% if(p.client_id){ %>SharePoint client: <%= p.client_id %> — loading current stage…<% } %></div></section><% for(const n of notifications){ %><p class="pill"><%= n.kind %>: <%= n.status %></p><% } %><section class="card"><h2>Log an activity</h2><form method="post" action="/prospects/<%= p.id %>/activities"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="grid"><div><label>Type</label><select name="type"><% for(const t of ['call','visit','email','note']){ %><option><%= t %></option><% } %></select></div><div><label>Outcome</label><select name="outcome"><% for(const o of outcomes){ %><option><%= o %></option><% } %></select></div><div><label>Date</label><input type="date" name="occurred_on" value="<%= new Date().toISOString().slice(0,10) %>"></div></div><label>Notes</label><textarea name="notes"></textarea><button>Log activity</button></form></section><section class="card"><h2>Activity history</h2><% for(const a of activities){ %><p><strong><%= a.occurred_on %> · <%= a.type %> · <%= a.outcome %></strong><br><%= a.notes %></p><% } %></section><%- include('footer') %>