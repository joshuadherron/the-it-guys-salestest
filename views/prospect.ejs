<%- include('header') %>
<p class="muted">
<%= p.opp %> · <%= p.stage %>
</p>
<h1>
<%= p.business_name %>
</h1>
<p>
<%= p.contact_name %> · <a href="tel:<%= p.phone %>"><%= p.phone %></a> · <%= p.email %>
</p>
<% if(p.street_address||p.city||p.state||p.zip){ %>
<p>
<%= p.street_address||'' %><% if(p.street_address&&(p.city||p.state||p.zip)){ %><br><% } %>
<%= p.city||'' %><%= p.city&&p.state?', ':'' %><%= p.state||'' %><%= p.zip?' '+p.zip:'' %>
</p>
<% } %>
<div data-workflow-panel="<%= p.id %>"><%- include('workflow-panel') %></div>
<div class="row no-print">
<a class="button" href="/prospects/<%= p.id %>/discovery/1">Business discovery</a>
<a class="button secondary" href="/prospects/<%= p.id %>/quotes">BII worksheet</a>
<a class="button secondary" href="/prospects/<%= p.id %>/handoff">SharePoint actions &amp; history</a>
<a href="/prospects/<%= p.id %>/edit">Edit prospect</a>
</div>
<section class="card">
<h2>Prospect notes</h2>
<p>Follow-up: <%= p.follow_up||'Not scheduled' %> · Owner: <%= p.owner %>
</p>
<p>Likely Service: <%= p.likely_service||'Unset' %> — commercial interest; workflow lane is separate.</p>
<p>Workflow lane: <%= p.service_lane||'Unset' %></p>
<p>
<%= p.notes %>
</p>

</section>
<section class="card"><h2>Next action, meeting & migration details</h2>
<% for(const [key,label] of structuredFields){if(p[key]!==null&&p[key]!==undefined&&p[key]!==''){ %><p class="preserve-lines"><strong><%= label %>:</strong> <%= ['teams_scheduled','josh_needed'].includes(key)?(p[key]?'Yes':'No'):p[key] %></p><% }} %>
<% if(p.legacy_stage){ %><p>Original source stage: <%= p.legacy_stage %></p><% } %>
<% if(p.import_source){ %><p>Import source: <%= p.import_source %></p><% } %>
<% if(p.likely_tier&&p.likely_tier!=='Not sure'){ %><p>Historical tier (source only): <%= p.likely_tier %>. Not a current service offering.</p><% } %>
</section>
<% for(const n of notifications){ %>
<p class="pill">
<%= n.kind %>: <%= n.status %>
</p>
<% } %>
<section class="card">
<h2>Log an activity</h2>
<form method="post" action="/prospects/<%= p.id %>/activities">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="grid">
<div>
<label>Type</label>
<select name="type">
<% for(const t of ['call','visit','email','note']){ %>
<option>
<%= t %>
</option>
<% } %>
</select>
</div>
<div>
<label>Outcome</label>
<select name="outcome">
<% for(const o of outcomes){ %>
<option>
<%= o %>
</option>
<% } %>
</select>
</div>
<div>
<label>Date</label>
<input type="date" name="occurred_on" value="<%= new Date().toISOString().slice(0,10) %>">
</div>
</div>
<label>Notes</label>
<textarea name="notes">
</textarea>
<button>Log activity</button>
</form>
</section>
<section class="card">
<h2>Activity history</h2>
<% for(const a of activities){ %>
<p>
<strong>
<%= a.occurred_on %> · <%= a.type %> · <%= a.outcome %>
</strong>
<br>
<%= a.notes %>
</p>
<% } %>
</section>
<%- include('footer') %>