<%- include('header') %>
<link rel="stylesheet" href="/quote-document.css?v=2">
<div class="quote-document-page">
<p><a href="/prospects/<%= p.id %>/quotes?quote=<%= q.id %>#selected-quote">Back to approved quote</a></p>
<h1>Generate <%= lane.label %> - <%= q.quote_number || ('Quote #' + q.id) %></h1>
<p>Quote-send permission is required. Known facts are prefilled for review. Blank facts remain visible placeholders and are reported as unfilled. Downloading a draft does not write to SharePoint or send email. The separate Fill action uses the mode shown below; Send remains a separate explicit action.</p>
<p>Fill mode: <strong><%= typeof fillMode!=='undefined'?fillMode:'dryrun' %></strong>. Live replaces the existing quote Word content; dryrun only records a preview.</p>
<form method="post" action="/quotes/<%= q.id %>/document" class="card quote-document-form">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="lane" value="<%= lane.key %>">
<% if(lane.key === 'COM-PRP'){ %>
<h2>Client and contact facts</h2><div class="grid quote-document-fields">
<% for(const [key,label,type] of [['legalName','Client legal name','text'],['preparedName','Prepared for - Name','text'],['preparedTitle','Prepared for - Title','text'],['preparedEmail','Prepared for - Email','email'],['backupContact','Backup contact','text']]){ %>
<label><%= label %><input name="<%= key %>" type="<%= type %>" maxlength="4000" value="<%= prefill[key] || '' %>"></label><% } %>
<label>Number of sites<input type="number" name="siteCount" min="1" step="1" value="<%= prefill.siteCount ?? 1 %>"></label>
<label>Site cities (only needed for multiple sites; names only)<input name="siteCities" value="<%= Number(prefill.siteCount ?? 1)>1 ? (prefill.siteCities || '') : '' %>" placeholder="Beaumont, Nederland" maxlength="4000"></label>
<label>Email / Microsoft 365 domain<input name="domain" value="<%= prefill.domain || '' %>" placeholder="example.com" maxlength="253"></label></div>
<fieldset><legend>Service start</legend><label><input type="radio" name="serviceStartMode" value="after_contracts" <%= prefill.serviceStartMode==='after_contracts'?'checked':'' %>>After contracts are signed</label><label><input type="radio" name="serviceStartMode" value="date" <%= prefill.serviceStartMode==='date'?'checked':'' %>>Choose a date</label><input type="date" name="serviceStartDate" value="<%= prefill.serviceStartDate || '' %>"></fieldset>
<label>Service summary<textarea name="summary" minlength="40" maxlength="4000" rows="4"><%= prefill.summary || '' %></textarea></label><p>Use a complete summary of at least 40 characters. Josh may edit the standard sentence.</p>
<fieldset><legend>Covered device kinds</legend><% for(const kind of ['computers','phones','tablets']){ %><label><input type="checkbox" name="deviceKinds" value="<%= kind %>" <%= (prefill.deviceKinds||[]).includes(kind)?'checked':'' %>><%= kind[0].toUpperCase()+kind.slice(1) %></label><% } %></fieldset>
<p>Assigned quantities from the approved worksheet: <strong><%= prefill.assignedSummary || 'No assigned company devices recorded' %></strong>. Separately billed shared devices: <%= prefill.quoteSharedDevices ?? 0 %>. Change device counts in the worksheet and save/approve a revised quote.</p>
<% if(prefill.quoteComputers === 0){ %>
<div class="quote-document-confirmation" id="device-confirmation">
<strong>Device confirmation required</strong>
<p>This approved quote records zero company computers. Confirm that users work on shared devices only. If this is incorrect, return to the worksheet, correct the quantities, and approve a revised quote.</p>
<label><input type="checkbox" name="noCompanyComputers" value="yes" id="no-company-computers" <%= prefill.noCompanyComputers?'checked':'' %> required>No company computers — users on shared devices only</label>
</div>
<% }else{ %>
<label><input type="checkbox" name="noCompanyComputers" value="yes" <%= prefill.noCompanyComputers?'checked':'' %>>No company computers - users on shared devices only</label>
<% } %>
<fieldset><legend>Onboarding scope</legend><label><input type="radio" name="onboardingMode" value="standard" <%= prefill.onboardingMode==='standard'?'checked':'' %>>Standard</label><label><input type="radio" name="onboardingMode" value="after_bii" <%= prefill.onboardingMode==='after_bii'?'checked':'' %>>After a Business IT Integration project</label></fieldset>
<input type="hidden" name="onboardingFee" value="<%= prefill.onboardingFee ?? 0 %>">
<div class="quote-document-readonly-fee"><label for="approved-onboarding-fee">Approved onboarding fee (view only)</label><input id="approved-onboarding-fee" type="text" value="$<%= Number(prefill.onboardingFee ?? 0).toFixed(2) %>" readonly aria-readonly="true"><small>From the approved quote. To change pricing, revise and approve the quote first.</small></div>
<label><input type="checkbox" name="waiveOnboarding" value="yes" <%= prefill.waiveOnboarding?'checked':'' %>>Waive onboarding (approved fee must be zero)</label><label>Waiver note<textarea name="waiverNote" rows="1" maxlength="4000"><%= prefill.waiverNote || '' %></textarea></label>
<fieldset><legend>On-site</legend><label><input type="radio" name="onsiteMode" value="hourly" <%= prefill.onsiteMode==='hourly'?'checked':'' %>>Hourly (as needed)</label><label><input type="radio" name="onsiteMode" value="block" <%= prefill.onsiteMode==='block'?'checked':'' %>>Block</label><label>Block hours per month<input type="number" name="onsiteHours" min="0" step="1" value="<%= prefill.onsiteHours ?? 0 %>"></label><p>Block hours must match the approved worksheet. Hourly visits are $125/hour in 30-minute increments.</p></fieldset>
<label>Client-specific terms<textarea name="clientTerms" maxlength="4000"><%= prefill.clientTerms || 'None.' %></textarea></label><p>One sentence per term; also goes into the Client Service Schedule.</p>
<label>Sizing assumptions<select name="sizingMode"><% for(const [value,label] of [['today','your business as it is today'],['opening','your business as it opens'],['other','Other']]){ %><option value="<%= value %>" <%= prefill.sizingMode===value?'selected':'' %>><%= label %></option><% } %></select></label><label>Other sizing assumption<input name="sizingOther" maxlength="4000" value="<%= prefill.sizingOther || '' %>"></label><p>This plan is sized for ___.</p>
<label>LOB prefix (optional, e.g. dental practice-management or other)<input name="lobPrefix" maxlength="4000" value="<%= prefill.lobPrefix || '' %>"></label><label>Extra exclusions (optional)<textarea name="extraExclusions" maxlength="4000"><%= prefill.extraExclusions || '' %></textarea></label>
<label><input type="checkbox" name="hipaa" value="yes" <%= prefill.hipaa?'checked':'' %>>HIPAA-related service terms apply</label>
<% }else{ %><div class="grid">
<% for(const [key,label] of [['legalName','Client legal name'],['preparedFor','Prepared for'],['backupContact','Backup contact'],['location','Primary location'],['domain','Primary domain'],['targetTiming','Target timing'],['summary','Project summary'],['deviceTypes','Device types'],['exceptions','Exceptions'],['signer','Authorized signer name and title']]){ %><label><%= label %><textarea name="<%= key %>" rows="2" maxlength="4000" required><%= prefill[key] || '' %></textarea></label><% } %></div><h2>Optional project details</h2>
<div class="quote-document-optional">
<% for(const [key,label] of [['deviceNote','Device notes'],['hardwareText','Hardware scope'],['locationText','Additional location scope'],['regulatedText','Regulated-data scope'],['lobExclusion','Line-of-business application exclusions'],['extraExclusions','Additional exclusions'],['extraAssumption','Additional assumptions']]){ %><label><%= label %><textarea name="<%= key %>" rows="2" maxlength="4000"><%= prefill[key] || '' %></textarea></label><% } %></div>
<% } %>
<p><strong>Review required:</strong> This preview may contain bracketed placeholders and is not ready for client use until reviewed.</p><button type="submit">Download draft Word document</button><button type="submit" name="action" value="FillSharePoint">Fill Quote/SOW in SharePoint</button><a href="/quotes/<%= q.id %>/delivery">Send / delivery status</a></form></div>
<%- include('footer') %>
