<%- include('header') %><h1>Discovery history — <%= p.business_name %></h1><p><a href="/prospects/<%= p.id %>"><%= p.opp %></a> · Current type: <%= engagementTypes[p.engagement_type]||'Legacy opportunity' %></p><p>Past revisions are preserved. A type correction archives the old questionnaire and opens a draft for the new type. This page shows the latest 200 revisions.</p>
<% if(!versions.length){ %><p>No saved discovery revisions.</p><% } %>
<% for(const version of versions){const answers=json(version.answers),archive=answers._type_archive; %><details class="card"><summary>Revision <%= version.revision %> · <%= version.actor %> · <%= version.created_at %><%= archive?' · Archived before type correction':'' %></summary><% if(archive){ %><p><%= engagementTypes[archive.from] %> → <%= engagementTypes[archive.to] %> · Previous state: <%= archive.status %></p><% } %><pre><%= JSON.stringify(answers,null,2) %></pre></details><% } %><%- include('footer') %>
