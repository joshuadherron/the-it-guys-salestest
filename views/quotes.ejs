<%- include('header') %>
<link rel="stylesheet" href="/quote-layout.css?v=11">
<div class="quote-page">
<p>
<a href="/prospects/<%= p.id %>">
<%= p.opp %> · <%= p.business_name %>
</a>
</p>
<% if(quotes.length){ %>
<details class="card" id="quote-history" open>
<summary><strong>Quote History</strong> <span class="muted">(<%= quotes.length %> saved)</span></summary>
<p>Open a saved quote to review, approve, delete, or print it.</p>
<div class="quote-history-scroll" role="region" aria-label="Saved quote history" tabindex="0">
<table class="quote-history-table">
<thead><tr><th>Quote</th><th>Status</th><th>Amount</th><th>Billing</th><th>Actions</th></tr></thead>
<tbody>
<% for(const q of quotes){ %>
<tr>
<td><strong><%= q.quoteName %> #<%= q.id %></strong></td>
<td><%= q.status %></td>
<td class="quote-history-amount">$<%= Number(q.total).toFixed(2) %></td>
<td><%= q.billingLabel %></td>
<td class="quote-history-actions"><a href="/prospects/<%= p.id %>/quotes?quote=<%= q.id %>#selected-quote">Review</a><% if(user.role==="owner"){ %><a href="/prospects/<%= p.id %>/quotes?edit=<%= q.id %>#<%= q.docInput.pricingMode==="managed_v20"?"managed-services-section":"bii-services-section" %>">Edit</a><% } %><a href="/quotes/<%= q.id %>/print">Print</a><% if(user.role==="owner" && q.status==="Approved" && !p.hold){ %><a href="/quotes/<%= q.id %>/document?lane=<%= q.docInput.pricingMode==="managed_v20"?"COM-PRP":"BII-QSOW" %>">Prepare Contract</a><% } %></td>
</tr>
<% } %>
</tbody></table></div>
</details>
 <% } %>
<h1>Pricing worksheet</h1>
<% if(editing){ %><p class="quote-edit-notice"><strong>Editing <%= editing.quoteName %> #<%= editing.id %>:</strong> <%= editing.status==="Approved"?"The approved quote is preserved. Saving creates a new draft revision for approval.":"Saving updates this draft quote." %> <a href="/prospects/<%= p.id %>/quotes">Cancel editing</a></p><% } %>
<p>Josh-approved commercial worksheet. Hardware quoted separately. All personal phones count as zero managed business devices.</p>
<% if(p.hold){ %>
<div class="hold">On Hold — Pending Josh Review. Quote actions are blocked.</div>
<% } %>
<% if(selected){ %>
<section class="card" id="selected-quote" role="dialog" aria-modal="true" aria-labelledby="selected-quote-title" tabindex="-1">
<div class="quote-review-header"><a class="button secondary quote-review-close" href="/prospects/<%= p.id %>/quotes#quote-history" aria-label="Close quote review and return to pricing worksheet">Close review ×</a></div>
<h2 id="selected-quote-title"><%= selected.quoteName %> #<%= selected.id %> · <%= selected.status %>
</h2>
<p>Approved by: <%= selected.approved_by||'Not approved' %> <%= selected.approved_at||'' %>
</p>
<% if(user.role==="owner" && !p.hold){ %>
<div class="quote-review-edit-actions">
<button type="button" id="quote-review-edit-toggle" aria-expanded="false" aria-controls="quote-review-edit-form">Enable Editing</button>
</div>
<form id="quote-review-edit-form" class="quote-review-edit-form" method="post" action="/quotes/<%= selected.id %>/edit" hidden>
<input type="hidden" name="_csrf" value="<%= csrf %>">
<h3>Edit saved quote #<%= selected.id %></h3>
<p><%= selected.status==="Approved"?"Saving creates a new draft revision. The approved quote remains unchanged.":"Saving updates this draft in place." %></p>
<div class="grid">
<% if(selected.docInput.pricingMode==="managed_v20"){ %>
<div><label>Service tier</label><select name="serviceTier"><% for(const [value,label] of [["managed","Managed IT"],["monitoring","Monitoring-only"],["none","No Managed Services"]]){ %><option value="<%= value %>" <%= selected.docInput.serviceTier===value?"selected":"" %>><%= label %></option><% } %></select></div>
<% for(const [key,label] of [["users","Managed users"],["computers","Business computers"],["assignedPhones","Assigned company phones"],["assignedTablets","Assigned company tablets"],["monitoringDevices","Monitoring-only devices"],["servers","Managed servers"],["extraDevices","Additional/shared devices"],["backupUsers","M365 backup users"],["onsiteHours","Monthly on-site hours"],["onboarding","One-time onboarding"],["workstationBackups","Workstation backups"],["serverBackups","Server backups"]]){ %>
<div><label for="review-edit-<%= key %>"><%= label %></label><input id="review-edit-<%= key %>" type="number" name="<%= key %>" min="0" step="<%= key==="onboarding"?"0.01":"1" %>" required value="<%= selected.docInput[key]??0 %>"></div>
<% } %>
<% }else{ %>
<% for(const [key,label] of [["users","Integration users"],["windows","Windows devices"],["mac","Mac devices"],["ios","Company iOS devices"],["android","Company Android devices"],["unallocated","Unassigned-platform devices"],["mailboxes","Mailbox migrations"],["dell","Dell deployments"],["phones","Personal/BYOD phones"],["locations","Locations"]]){ %>
<div><label for="review-edit-<%= key %>"><%= label %></label><input id="review-edit-<%= key %>" type="number" name="<%= key %>" min="0" step="1" required value="<%= selected.docInput[key]??0 %>"></div>
<% } %>
<div><label for="review-edit-locationLaborBase">Additional-location labor base</label><input id="review-edit-locationLaborBase" type="number" name="locationLaborBase" min="0" step="0.01" value="<%= selected.docInput.locationLaborBase??"" %>"></div>
<% } %>
</div>
<% if(selected.docInput.pricingMode!=="managed_v20"){ %>
<h4>Custom BII scope</h4>
<div class="grid">
<% for(const [i,label] of oneOffItems.entries()){const item=selected.docInput.oneOff?.[label]||{}; %>
<div><label><input type="checkbox" name="oneoff_<%= i %>" value="yes" <%= item.selected?"checked":"" %>> <%= label %></label><input type="number" name="amount_<%= i %>" min="0" step="0.01" aria-label="<%= label %> custom price" value="<%= item.amount??"" %>" placeholder="Owner price"></div>
<% } %>
</div>
<% } %>
<label><input type="checkbox" name="includeBii" value="yes" <%= selected.docInput.includeBii?"checked":"" %>> Include BII integration</label>
<label><input type="checkbox" name="confirmed" value="yes" required> I verified the revised counts, scope and pricing inputs.</label>
<div class="quote-review-edit-buttons"><button type="submit"><%= selected.status==="Approved"?"Save New Draft Revision":"Save Changes" %></button><button type="button" id="quote-review-edit-cancel" class="secondary">Cancel Editing</button></div>
</form>
<% } %>
<div class="saved-quote-review" id="quote-review-snapshot" aria-label="Saved quote details">
<h3>Saved quote — scope and pricing</h3>
<p class="muted">This is the saved snapshot for quote #<%= selected.id %>, not the live estimate from the editors below.</p>
<div class="grid">
<% for(const [key,label] of (selected.docInput.pricingMode==="managed_v20"
 ? [["serviceTier","Service tier"],["users","Managed users"],["computers","Business computers"],["assignedPhones","Assigned company phones"],["assignedTablets","Assigned company tablets"],["monitoringDevices","Monitoring-only devices"],["servers","Managed servers"],["extraDevices","Additional/shared devices"],["backupUsers","M365 backup users"],["onsiteHours","Monthly on-site hours"],["onboarding","One-time onboarding"],["includeBii","BII included"]]
 : [["users","Integration users"],["windows","Windows devices"],["mac","Mac devices"],["ios","Company iOS devices"],["android","Company Android devices"],["unallocated","Unassigned-platform devices"],["mailboxes","Mailbox migrations"],["dell","Dell deployments"],["phones","Personal/BYOD phones"],["locations","Locations"],["includeBii","BII included"]])){ %>
<div><strong><%= label %></strong><p><%= typeof selected.docInput[key]==="boolean"?(selected.docInput[key]?"Yes":"No"):(selected.docInput[key]??"Not specified") %></p></div>
<% } %>
</div>
<% const savedLines=selected.savedLines; %>
<div class="table-wrap">
<table><thead><tr><th>Saved line item</th><th>Quantity</th><th>Unit price</th><th>Amount</th><th>Billing</th></tr></thead>
<tbody>
<% for(const line of savedLines){ %>
<tr><td><%= line.label %></td><td><%= line.quantity??"—" %></td><td><%= line.unit===undefined?"—":"$"+Number(line.unit).toFixed(2) %></td><td>$<%= Number(line.amount).toFixed(2) %></td><td><%= selected.docInput.pricingMode!=="managed_v20"?"One-time":(line.billing==="one_time"?"One-time":"Monthly") %></td></tr>
<% } %>
</tbody></table>
</div>
<p><strong>Saved quote total: $<%= Number(selected.total).toFixed(2) %></strong> <span class="muted">(<%= selected.docInput.pricingMode==="managed_v20"?"includes the saved monthly pricing and any one-time items":"one-time BII pricing" %>)</span></p>
<% if(selected.docInput.pricingMode==="managed_v20"){ %>
<p><strong>Monthly recurring: $<%= savedLines.filter(l=>l.billing!=="one_time").reduce((n,l)=>n+Number(l.amount),0).toFixed(2) %></strong> · <strong>One-time line items: $<%= savedLines.filter(l=>l.billing==="one_time").reduce((n,l)=>n+Number(l.amount),0).toFixed(2) %></strong></p>
<% } %>
<% const selectedOneOffs=Object.entries(selected.docInput.oneOff||{}).filter(([,item])=>item.selected); %>
<% if(selectedOneOffs.length){ %>
<h4>Owner-priced custom scope</h4>
<% for(const [label,item] of selectedOneOffs){ %><p><%= label %>: <%= item.amount===null?"Pending owner price":"$"+Number(item.amount).toFixed(2) %></p><% } %>
<% } %>
</div>
<a href="/quotes/<%= selected.id %>/print">Printable internal worksheet</a>
<% if(user.role==="owner" && selected.status==="Approved"){ %>
<a class="button quote-document-action" href="/quotes/<%= selected.id %>/document?lane=<%= selected.docInput.pricingMode==="managed_v20"?"COM-PRP":"BII-QSOW" %>">Prepare contractual Word quote</a>

<% } %>
<% if(user.role==='owner'&&selected.status==='Draft'){ %>
<form method="post" action="/quotes/<%= selected.id %>/delete" data-confirm="Delete this draft quote? This cannot be undone.">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button type="submit">Delete draft</button>
</form>
<form method="post" action="/quotes/<%= selected.id %>/approve">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<h3>Pre-quote stop conditions</h3>
<p>Tick any condition that applies. Any tick blocks approval: targeted assessment first.</p>
<% if(!selected.docInput.confirmed){ %>
<label>
<input type="checkbox" name="confirm_counts" value="yes" required> I confirm the saved draft counts, including zero values and devices counted once.
</label>
<% } %>
<% for(const stop of stops){ %>
<label>
<input type="checkbox" name="stop_<%= stop.id %>" value="yes"> <%= stop.label %> · <%= stop.status %>
</label>
<% } %>
<label>
<input type="checkbox" name="reviewed" value="yes" required> I reviewed every stop condition.</label>
<button <%= p.hold?'disabled':'' %>>Approve pricing</button>
</form>
<% } %>
</section>
<% } %>

<div class="quote-builder-layout"><div class="quote-builder-main">
<details class="card" id="managed-services-section"><summary><strong>Managed Services</strong> <span class="quote-summary-control" onclick="event.stopPropagation()"><label for="managed-tier-select">Service</label><select id="managed-tier-select" name="serviceTier" form="managed-pricing-form"><option value="none" <%= !managedInput.pricingMode ? "selected" : "" %>>No Managed Services</option><option value="managed" <%= managedInput.pricingMode && managedInput.serviceTier !== "monitoring" && managedInput.serviceTier !== "none" ? "selected" : "" %>>Managed IT — $125/user</option><option value="monitoring" <%= managedInput.serviceTier === "monitoring" && managedInput.pricingMode ? "selected" : "" %>>Monitoring-Only — $45/device</option></select></span><span id="managed-services-summary-total" aria-live="polite">Quote total: calculating…</span></summary>
<p>Managed IT includes SentinelOne EDR and Adlumin MDR. Monthly services and one-time onboarding are separate. No automatic volume discounts.</p>
<form id="managed-pricing-form" method="post" action="<%= editing?.docInput.pricingMode==="managed_v20"?"/quotes/"+editing.id+"/edit":"/prospects/"+p.id+"/quotes/managed" %>" data-quote-calculator data-calculate-url="/prospects/<%= p.id %>/quotes/managed/calculate" data-preview-target="quote-calculation" data-status-target="quote-preview-status">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<fieldset <%= p.hold?'disabled':'' %>>
<div class="grid">

<div><label>Managed users</label><input type="number" name="users" min="0" required value="<%= managedInput.users ?? 0 %>"></div>
<div><label>Monitoring-only devices</label><input type="number" name="monitoringDevices" min="0" required value="<%= managedInput.monitoringDevices ?? 0 %>"></div>
<div><label>Managed servers ($75/month)</label><input type="number" name="servers" min="0" required value="<%= managedInput.servers ?? 0 %>"></div>
<div><label>Shared/additional devices ($15/month, Managed IT)</label><input type="number" name="extraDevices" min="0" required value="<%= managedInput.extraDevices ?? 0 %>"></div>
<div><label>Microsoft 365 backup users ($5/month)</label><input type="number" name="backupUsers" min="0" required value="<%= managedInput.backupUsers ?? 0 %>"></div>
<div><label>Monthly on-site block hours ($115/hour)</label><input type="number" name="onsiteHours" min="0" required value="<%= managedInput.onsiteHours ?? 0 %>"></div>
<div><label>Business computers (owner review above 3 assigned devices/user)</label><input type="number" name="computers" min="0" required value="<%= managedInput.computers ?? 0 %>"></div>
<div><label>Assigned company phones (included allowance)</label><input type="number" name="assignedPhones" min="0" value="<%= managedInput.assignedPhones ?? 0 %>"></div>
<div><label>Assigned company tablets (included allowance)</label><input type="number" name="assignedTablets" min="0" value="<%= managedInput.assignedTablets ?? 0 %>"></div>
<div><label>Workstations requiring custom backup quote</label><input type="number" name="workstationBackups" min="0" required value="<%= managedInput.workstationBackups ?? 0 %>"></div>
<div><label>Servers requiring custom backup quote</label><input type="number" name="serverBackups" min="0" required value="<%= managedInput.serverBackups ?? 0 %>"></div>
<p>For BII implementation, use the BII Services section below. Its charges are added to the build total once.</p>
<div class="onboarding-guidance-field">
<label for="managed-onboarding">One-time onboarding — owner-selected ($)</label>
<input id="managed-onboarding" type="number" name="onboarding" min="0" step="0.01" value="<%= managedInput.onboarding ?? 0 %>">
<div id="onboarding-guidance" role="status" aria-live="polite"><strong>Guidance:</strong> Enter user/device quantities to see the v16 reference range.</div>
<label for="onboarding-complexity">Onboarding complexity</label>
<select id="onboarding-complexity"><option value="unknown">Not assessed</option><option value="simple">Simple / standardized</option><option value="standard">Standard</option><option value="complex">Complex / regulated / multi-site</option></select>
<button type="button" id="apply-onboarding-guidance" class="secondary" hidden>Use suggested midpoint</button>
<small>Internal Quoting Guide v16: reference ranges, not automatic pricing. Owner determines final fee.</small>
</div>
</div>
<label><input type="checkbox" name="confirmed" value="yes" required> I confirmed quantities, scope, and custom-price items.</label>
</fieldset>
<button <%= user.role!=='owner'||p.hold?'disabled':'' %>><%= editing?.docInput.pricingMode==="managed_v20"?(editing.status==="Approved"?"Save new draft revision":"Save changes to draft"):"Save managed services draft" %></button>
</form>
<p>On-site as needed: $125/hr subscribed, billed separately. Additional locations are scoped individually; no standard recurring location fee.</p>
<div><h3>Managed Services estimate</h3><div id="quote-calculation"></div><p id="quote-preview-status" role="status"></p></div>
</details>
<details class="card" id="bii-services-section"><summary><strong>BII Services</strong> · One-time implementation <span class="quote-summary-control" onclick="event.stopPropagation()"><label><input type="checkbox" name="includeBii" value="yes" form="bii-pricing-form" <%= input.includeBii ? "checked" : "" %>> Include Standard BII Integration</label></span></summary>
<p>BII foundation, included allowances and additional-unit rates are calculated from the existing centrally configured BII prices. This is a one-time implementation estimate, not part of the monthly Managed IT total.</p>
<form id="bii-pricing-form" method="post" action="<%= editing && editing.docInput.pricingMode!=="managed_v20"?"/quotes/"+editing.id+"/edit":"/prospects/"+p.id+"/quotes" %>" class="card" data-quote-calculator data-calculate-url="/prospects/<%= p.id %>/quotes/calculate" data-preview-target="bii-quote-calculation" data-status-target="bii-preview-status">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<fieldset <%= p.hold?'disabled':'' %>>
<legend>BII scope — Josh confirms these before approval</legend>

<p>Discovery computer counts start under platform not yet assigned. Move devices into platform rows without counting them twice. Uncaptured counts start at 0 and require Josh's confirmation.</p>
<div class="grid">
<% for(const [key,label] of [['users','Integration users'],['windows','Windows managed business devices'],['mac','Mac managed business devices'],['ios','Company iPhone/iPad managed devices'],['android','Company Android managed devices'],['unallocated','Managed business devices — platform not yet assigned'],['mailboxes','Straightforward mailbox migrations'],['dell','New Dell deployments (labor)'],['phones','Personal / BYOD phones — counted as 0'],['locations','Locations']]){ %>
<div>
<label>
<%= label %>
</label>
<input name="<%= key %>" type="number" min="0" max="100000" required value="<%= input[key] ?? 0 %>">
</div>
<% } %>
</div>
<h2>Priced by Josh</h2>
<p>OWNER ONE-OFF — NOT STANDARD UNIT PRICE for custom items below. Mirrored additional locations are calculated separately at 30% of the owner-confirmed repeatable BII implementation labor applicable to those locations.</p>
<div class="row">
<div>
<label>Additional mirrored location repeatable labor base</label>
<input type="number" step="0.01" min="0" name="locationLaborBase" value="<%= input.locationLaborBase??'' %>">
</div>
<p>When there is more than one additional mirrored location, enter the sum of the repeatable implementation labor base applicable to each additional location. Exclude hardware, software/licenses, Brownfield Remediation, migrations, Advanced Technology Assessment, and specialized/custom work.</p>
</div>
<% for(const [i,label] of oneOffItems.entries()){ %>
<div class="row">
<label>
<input type="checkbox" name="oneoff_<%= i %>" value="yes" <%= input.oneOff?.[label]?.selected?'checked':'' %>> <%= label %>
</label>
<div>
<label>Priced by Josh — amount</label>
<div class="currency-input"><span class="currency-prefix" aria-hidden="true">$</span><input type="number" step="0.01" min="0" name="amount_<%= i %>" placeholder="0.00" aria-label="<%= label %> dollar amount" value="<%= input.oneOff?.[label]?.amount??'' %>"></div>
</div>
</div>
<% } %>
<label>
<input type="checkbox" name="confirmed" value="yes" <%= input.confirmed?'checked':'' %> <%= user.role==='owner'?'required':'' %>> I have confirmed all counts, including zero values and devices counted once.</label>
</fieldset>
<button <%= p.hold?'disabled':'' %>>
<%= editing && editing.docInput.pricingMode!=='managed_v20'?(editing.status==='Approved'?'Save new draft revision':'Save changes to draft'):(user.role==='owner'?'Save new draft':'Create draft from discovery for Josh') %>
</button>
</form>
<h3>BII project estimate preview</h3><div id="bii-quote-calculation"></div><p id="bii-preview-status" role="status"></p>
</details>
</div><aside class="quote-builder-sidebar" aria-label="Live quote summary"><section class="card" id="build-total" aria-live="polite">
<h2>Quote Summary</h2>
<p>Live estimate from the selected Managed Services and BII Services above. No need to save a draft to see pricing.</p>
<div class="grid">
<div><p>Managed Services</p><h2 id="build-monthly">$0.00 / month</h2></div>
<div><p>BII Implementation</p><h2 id="build-bii">$0.00 one-time</h2></div>
<div><p>Managed IT Onboarding</p><h2 id="build-onboarding">$0.00 one-time</h2></div>
<div><p>Total one-time investment</p><h2 id="build-onetime">$0.00</h2></div>
</div>
<p id="build-first-month"><strong>Estimated first month plus one-time charges:</strong> Calculating…</p>
<p id="build-review" role="status">Calculating service estimates…</p>
<p>Estimate only; excludes taxes, hardware, licenses and custom-priced services not yet entered. Owner approval required before a binding quote.</p>
</section></aside></div>
<% if(editing){ %>
<script>
document.addEventListener("DOMContentLoaded",()=>{
 const section=document.getElementById("<%= editing.docInput.pricingMode==="managed_v20"?"managed-services-section":"bii-services-section" %>");
 if(section){section.open=true;section.scrollIntoView({block:"nearest"});}
});
</script>
<% } %>
<script src="/quote-review-edit.js?v=1" defer></script>
<script src="/onboarding-guidance.js?v=1" defer></script>
<script src="/quote-calculator.js?v=20261015-10" defer></script>
</div>
<%- include('footer') %>