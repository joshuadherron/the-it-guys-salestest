<%- include('header') %>
<div class="row">
<div>
<p class="muted">YOUR SALES WORKSPACE</p>
<h1>
<%= today?'Your sales dashboard':'All prospects' %>
</h1>
<p>
<%= today?'See who needs attention, record conversations, and keep relationships moving.':'Find and manage every prospect relationship in one place.' %>
</p>
</div>
<div>
<a class="button" href="/prospects/new">+ Add business</a>
</div>
</div>
<% if(today){ if(user.role==='owner'){ %>
<details class="card dashboard-collapse"><summary class="dashboard-collapse-heading">Waiting for Josh <span class="pill"><%= waiting.length %></span></summary>
<% if(!waiting.length){ %><p>Nothing waiting for review.</p><% } %>
<% for(const item of waiting){ %><article class="card"><a href="<%= item.href %>"><%= item.business_name %> — <%= item.label %></a>
<% if(item.result_message){ %><p class="error preserve-lines"><%= item.result_message %></p><% } %>
<% if(item.request_id){ %><form method="post" action="/requests/<%= item.request_id %>/acknowledge"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Acknowledge</button></form><% } %>
</article><% } %></details>
<% }else{ %><p><%= waiting.length %> items waiting on Josh</p><% }} %>
<form method="get">
<div class="row">
<input name="q" value="<%= search %>" placeholder="Search business or contact" aria-label="Search">
<select name="status" aria-label="Filter by status"><option value="">All statuses</option><% for(const option of statusChoices){ %><option value="<%= option %>" <%= selectedStatus===option?'selected':'' %>><%= option %></option><% } %></select>
<button>Search</button>
</div>
</form>
<% const due=rows.filter(p=>p.follow_up && String(p.follow_up).slice(0,10)<=new Date().toISOString().slice(0,10)); const upcoming=rows.filter(p=>p.follow_up && String(p.follow_up).slice(0,10)>new Date().toISOString().slice(0,10)); const unscheduled=rows.filter(p=>!p.follow_up); %><% if(today){ %><div class="dashboard-stats" aria-label="Sales dashboard shortcuts">
<a class="dashboard-stat" href="/pipeline"><strong><%= rows.length %></strong><span>Businesses</span><span class="stat-action">View all businesses →</span></a>
<a class="dashboard-stat" href="#needs-follow-up"><strong><%= due.length %></strong><span>Due for follow-up</span><span class="stat-action">View follow-ups →</span></a>
<a class="dashboard-stat" href="#no-follow-up"><strong><%= unscheduled.length %></strong><span>No follow-up set</span><span class="stat-action">Schedule follow-ups →</span></a>
</div><% } %><% const groups=today?[{name:'Needs follow-up',rows:due},{name:'Upcoming conversations',rows:upcoming},{name:'No follow-up scheduled',rows:unscheduled}]:[{name:'Prospects',rows}];for(const group of groups){ %>
<details class="card dashboard-collapse" <%= !today?'open':'' %> id="<%= group.name==='Needs follow-up'?'needs-follow-up':group.name==='No follow-up scheduled'?'no-follow-up':'upcoming-conversations' %>">
<summary class="dashboard-collapse-heading">
<%= group.name %> <span class="pill">
<%= group.rows.length %>
</span>
</summary>
<% if(!group.rows.length){ %>
<p class="muted">No opportunities here yet.</p>
<% }for(const p of group.rows){ %>
<article class="card">
<div class="row">
<div>
<small>
<%= opportunity(p.id) %>
</small>
<h2>
<a href="/prospects/<%= p.id %>">
<%= p.business_name %>
</a>
</h2>
<p>
<%= p.contact_name %> · <%= p.phone %>
</p>
</div>
<div>
<span class="pill">
<%= p.stage %>
</span>
<% if(p.status){ %><p class="pill">Status: <%= p.status %></p><% } %>
<% if(p.legacy_stage){ %><p class="muted">Source stage: <%= p.legacy_stage %></p><% } %>
<% if(p.next_action){ %><p><%= p.next_action %> · <%= p.next_action_date||'' %> <%= p.next_action_time||'' %> <%= p.next_action_method||'' %></p><% } %>
<p>Interest: <%= p.likely_service||'Not specified' %></p>
<p>Follow-up: <%= p.follow_up||'Not scheduled' %>
</p>
<% if(p.hold){ %>
<strong class="error">On Hold — Pending Josh Review</strong>
<% } %>
</div>
</div>
</article>
<% } %>
</details>
<% } %>
<%- include('footer') %>