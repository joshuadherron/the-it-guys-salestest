<%- include('header') %><h1>Quote delivery - <%= q.quote_number || q.id %></h1><p><a href="/prospects/<%= p.id %>/quotes?quote=<%= q.id %>#selected-quote">Back to quote</a> | <a href="/quotes/<%= q.id %>/document">Review document facts / Save proposal to SharePoint</a></p>
<p>Send mode: <strong><%= sendMode %></strong>. A person must click Send. Dryrun emails only the signed-in user and saves no PDF; live saves one PDF and sends to the client. Nothing is sent automatically.</p>
<% if(fill){ %><section class="card"><h2>Latest fill: <%= fill.mode %> / <%= fill.status %></h2><% if(fill.web_url&&/^https:\/\//i.test(fill.web_url)){ %><a class="button" href="<%= fill.web_url %>" target="_blank" rel="noopener noreferrer">Open in Word</a><% } %><% if(fill.document_key==='BII-QSOW'){ %><p>Review in Word → set Signature Status = Ready to send → send the eSignature request from the email Flow 7 sends you.</p><% } %><h3>Unfilled-field checklist</h3><% if(report.unfilled.length){ %><ul><% for(const tag of report.unfilled){ %><li><%= tag %></li><% } %></ul><p>Complete these in Word. The current PDF is inspected before sending.</p><% }else{ %><p>No unfilled controls reported.</p><% } %></section><% } %>
<% if(reason){ %><p class="error"><%= reason %></p><% } %>
<% if((typeof documentKey!=='undefined'?documentKey:fill?.document_key)==='COM-PRP'){ %><form method="post" action="/quotes/<%= q.id %>/send" class="card" data-confirm="Send this quote using the shared mailbox in the displayed send mode?"><input type="hidden" name="_csrf" value="<%= csrf %>"><p>Primary recipient: <%= p.email %>. No automatic CC.</p><label>One optional CC<input name="cc" type="email"></label><label><input type="checkbox" name="reviewed_edits" value="yes">I reviewed the Word edits</label><label><input type="checkbox" name="internal_test" value="yes">Internal test (allow a theitguys.us primary recipient)</label><button <%= reason?'disabled':'' %>>Send quote to client</button></form><% } %>
<section class="card"><h2>Send attempts</h2><% for(const a of attempts){ %><article><h3><%= a.mode %> - <%= a.status %></h3><p><%= a.actor %> → <%= a.sent_to %><%= a.sent_cc?' / CC '+a.sent_cc:'' %> · <%= a.created_at %></p><% if(a.error_message){ %><p class="error"><%= a.error_message %></p><% } %><% if(a.status==='Failed'&&a.phase==='Email'&&a.pdf_item_id){ %><p>The saved PDF will be reused. No second PDF is created.</p><form method="post" action="/quotes/<%= q.id %>/send" data-confirm="Retry only the email with the saved PDF?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="retryId" value="<%= a.id %>"><button <%= reason?'disabled':'' %>>Retry email only</button></form><% } %><% if(['Unknown','Sending','Preparing'].includes(a.status)){ %><p>Delivery needs admin reconciliation. Do not resend until Sent Items and Commercial have been checked.</p><% } %></article><% } %></section><%- include('footer') %>
