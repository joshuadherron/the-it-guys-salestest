<%- include('header') %><h1>Import / Export</h1><p>One committed import per tab. Review every row before committing. Historical weekly totals should cover periods before app activity logging, to avoid double-counting.</p><div class="row"><a href="/export/pipeline">Export pipeline CSV</a><a href="/export/weekly">Export weekly CSV</a></div><% for(const [kind,columns] of Object.entries(headers)){ %><details><summary><%= kind %> CSV header template</summary><pre><%= columns.map(x=>'"'+x+'"').join(',') %></pre></details><% } %><% if(preview){ %><section class="card"><h2>Preview: <%= preview.kind %> — <%= preview.rows.length %> rows</h2><div class="table-wrap"><table><thead><tr><% for(const h of headers[preview.kind]){ %><th><%= h %></th><% } %></tr></thead><tbody><% for(const row of preview.rows){ %><tr><% for(const v of row){ %><td><%= v %></td><% } %></tr><% } %></tbody></table></div><form method="post" action="/import/commit"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Commit these rows</button></form></section><% } %><form method="post" action="/import/preview" class="card"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Tab</label><select name="kind"><option value="pipeline">Pipeline</option><option value="weekly">Weekly Tracker</option></select><label>CSV file</label><input id="csv-file" type="file" accept=".csv,text/csv"><label>CSV contents</label><textarea id="csv-content" name="csv" rows="12" required></textarea><button>Preview import</button></form><%- include('footer') %>