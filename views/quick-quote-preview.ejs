<%- include('header') %><h1>Preview · <%= q.quote_number||q.id %></h1>
<p><%= p.business_name %> · <%= p.contact_name %> · <%= p.email %></p>
<p>3. Preview → Send. Approval is recorded when an approver sends. Sending does not authorize work.</p>
<p><a href="/quick-quote/opportunities/<%= p.id %>?quote=<%= q.id %>">Edit / create revised draft</a></p>
<table><thead><tr><th>Item</th><th>Quantity</th><th>Amount</th></tr></thead><tbody><% for(const line of lines){ %><tr><td><%= line.label %></td><td><%= line.quantity %></td><td>$<%= Number(line.amount).toFixed(2) %></td></tr><% } %></tbody></table><p><strong>Total: $<%= Number(q.total).toFixed(2) %></strong></p>
<% if(input.scope){ %><h2>Scope</h2><p class="preserve-lines"><%= input.scope %></p><h3>Exclusions</h3><p class="preserve-lines"><%= input.exclusions %></p><h3>Assumptions</h3><p class="preserve-lines"><%= input.assumptions %></p><h3>Terms</h3><p class="preserve-lines"><%= input.terms %></p><% } %>
<% if(preview){ %><a class="button secondary" href="/quick-quote/quotes/<%= q.id %>/word">Preview Word document</a><p>Draft dates are provisional until Send. Word preview uses the pinned template and writes no SharePoint file.</p><% } %>
<% if(error){ %><p class="error"><%= error %> Return to Edit to complete the quote.</p><% } %>
<% if(preview?.report.unfilled.length){ %><p class="error">Complete these proposal facts before sending: <%= preview.report.unfilled.join(', ') %>.</p><% } %>
<% if(p.hold){ %><p class="hold">Security hold: ask Josh to resolve it before sending. Preview remains available.</p><% } %>
<% if(job?.status==='WaitingApproval'){ const options=typeof job.options_json==='string'?JSON.parse(job.options_json):job.options_json||{};const findings=stops.filter(s=>options['stop_'+s.id]==='yes'); %><h2>Requested findings for Josh’s review</h2><% if(findings.length){ %><ul><% for(const finding of findings){ %><li><%= finding.label %></li><% } %></ul><p>Approve &amp; Send acknowledges these findings.</p><% }else{ %><p>No stop conditions selected.</p><% } %><% } %>
<% if(q.status==='Sent'){ %><p>This quote has been sent.</p><% }else if(job?.status==='WaitingApproval'&&!canApprove){ %><p>Waiting for Josh. Your quote and selections have been saved for approval.</p><% }else{ %>
<form method="post" action="/quick-quote/quotes/<%= q.id %>/send" data-quick-send>
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="hash" value="<%= hash %>">
<% if(!job){ %><details><summary>Optional stop conditions / assessment findings</summary><p>Select only findings that apply. None are selected automatically. The free scripted assessment (BT-7.32) is optional and is not a stop condition.</p><% for(const stop of stops){ %><label><input type="checkbox" name="stop_<%= stop.id %>" value="yes"><%= stop.label %></label><% } %></details>
<label>CC (optional)<input name="cc" type="email"></label><label><input name="internal_test" type="checkbox" value="yes">Internal recipient test</label><% }else{ %><p>Approve &amp; Send preserves the requester’s quote and selected findings.</p><% } %>
<button data-send-label="<%= canApprove?(job?.status==='WaitingApproval'?'Approve & Send':'Send'):'Send for Josh’s approval' %>" <%= p.hold||error||preview?.report.unfilled.length?'disabled':'' %>><%= canApprove?(job?.status==='WaitingApproval'?'Approve & Send':'Send'):'Send for Josh’s approval' %></button>
</form><% } %>
<script src="/quick-quote.js" defer></script><%- include('footer') %>
