<%- include('header') %>
<h1>Owner administration</h1>
<section class="card">
<h2>SharePoint connection</h2>
<p>Last checked: <%= schema.checkedAt||'Not checked' %>
</p>
<% for(const error of schema.errors){ %>
<p class="error">
<%= error %>
</p>
<% } for(const issue of [...new Set([...Object.values(schema.actionErrors||{}).flat(),...schema.workErrors||[],...schema.definitionErrors||[]])]){ %><p class="error"><%= issue %> Other handoff actions remain available.</p><% }if(!schema.errors.length){ %>
<p>Core handoff columns and choices are present.</p>
<% } %>
<form method="post" action="/admin/check">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button>Check SharePoint connection</button>
</form>
<details>
<summary>Resolved schema and exact choice values</summary>
<pre>
<%= JSON.stringify(schema,null,2) %>
</pre>
</details>
</section>
<section class="card">
<h2>Sales Prospects sync</h2>
<p>Prospects in Sales App: <strong><%= prospectCount %></strong></p>
<p>Automatic prospect sync is <strong><%= prospectSyncEnabled?'enabled':'disabled' %></strong>.</p>
<% if(prospectSyncSummary.length){ %>
<p>Request history:
<% for(const row of prospectSyncSummary){ %>
<span class="pill"><%= row.status %>: <%= row.count %></span>
<% } %>
</p>
<% } %>
<form method="post" action="/admin/prospect-backfill">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button <%= prospectSyncEnabled?'':'disabled' %>>Backfill all prospects to SharePoint</button>
</form>
<% if(!prospectSyncEnabled){ %>
<p class="muted">Create the Sales Prospects list and Upsert Prospect Power Automate handler first, then set PROSPECT_SYNC_ENABLED=true.</p>
<% } %>
</section>
<section class="card">
<h2>Prices & included amounts</h2>
<p>Changing prices returns approved worksheets to Draft for review.</p>
<% for(const price of prices){ %>
<form method="post" action="/admin/prices" class="row">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="name" value="<%= price.name %>">
<label>
<%= price.name %>
<input name="amount" type="number" min="0" step="0.01" value="<%= price.amount %>" required>
</label>
<button>Save</button>
</form>
<% } %>
</section>
<section class="card">
<h2>Pipeline stage order</h2>
<% for(const stage of stages){ %>
<form method="post" action="/admin/stages" class="row">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="name" value="<%= stage.name %>">
<label>
<%= stage.name %>
<%= stage.managed_only?' — Managed IT only':'' %>
<input type="number" min="0" name="sort_order" value="<%= stage.sort_order %>">
</label>
<button>Save order</button>
</form>
<% } %>
</section>
<section class="card">
<h2>Mark Lost reasons</h2>
<p>Flow-approved text is fixed. Enable reasons and set their display order.</p>
<% for(const reason of lostReasons){ %>
<form method="post" action="/admin/lost-reasons">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="reason" value="<%= reason.reason %>">
<strong><%= reason.reason %></strong>
<label>Order <input type="number" name="sort_order" min="0" value="<%= reason.sort_order %>" required></label>
<label><input type="checkbox" name="enabled" value="yes" <%= reason.enabled?'checked':'' %>> Enabled</label>
<button>Save reason</button>
</form>
<% } %>
</section>
<section class="card">
<h2>Pre-quote stop conditions</h2>
<% for(const stop of [...stops,{id:'',label:'',status:'Owner confirmed'}]){ %>
<form method="post" action="/admin/stops">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="id" value="<%= stop.id %>">
<label>
<%= stop.id?'Condition':'Add condition' %>
</label>
<input name="label" value="<%= stop.label %>" required>
<select name="status">
<% for(const state of ['TODO-OWNER','Owner confirmed']){ %>
<option <%= state===stop.status?'selected':'' %>>
<%= state %>
</option>
<% } %>
</select>
<button>Save condition</button>
</form>
<% } %>
</section>
<section class="card">
<h2>Allowlist</h2>
<% for(const entry of [...allowlist,{email:'',role:'sales',enabled:true}]){ %>
<form method="post" action="/admin/allowlist">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Tenant email</label>
<input name="email" type="email" value="<%= entry.email %>" required>
<select name="role">
<option <%= entry.role==='sales'?'selected':'' %>>sales</option>
<option <%= entry.role==='owner'?'selected':'' %>>owner</option>
</select>
<label>
<input type="checkbox" name="enabled" value="yes" <%= entry.enabled?'checked':'' %>> Enabled</label><label><input type="checkbox" name="is_admin" value="yes" <%= entry.is_admin?'checked':'' %>>admin</label><label><input type="checkbox" name="quote_approve" value="yes" <%= entry.quote_approve?'checked':'' %>>quote.approve</label><label><input type="checkbox" name="quote_send" value="yes" <%= entry.quote_send?'checked':'' %>>quote.send</label><label>Sender name<input name="display_name" maxlength="200" value="<%= entry.display_name||'' %>"></label><label>Sender title<input name="sender_title" maxlength="200" value="<%= entry.sender_title||'' %>"></label><label>Sender phone<input name="sender_phone" maxlength="80" value="<%= entry.sender_phone||'' %>"></label>
<button>Save user</button>
</form>
<% } %>
</section>
<% if(typeof quoteEmail!=='undefined'){ %><section class="card"><h2>Shared-mailbox quote email</h2><p>QUOTE_SENDER_MAILBOX: <%= quoteMailbox %>. This must be a dedicated shared mailbox, never workflow@ or a person's mailbox.</p><form method="post" action="/admin/quote-email"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Subject template<input name="subject_template" maxlength="250" value="<%= quoteEmail.subject_template %>" required></label><label>Body template<textarea name="body_template" maxlength="12000" rows="8" required><%= quoteEmail.body_template %></textarea></label><p>Tokens: {QuoteId}, {FirstName}, {MonthlyTotal}, {Onboarding}, {BAA phrase}, {SenderName}, {SenderTitle}, {SenderPhone}</p><button>Save quote email template</button></form></section><% } %>
<section class="card">
<h2>Audit log — latest 200 events</h2>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>When</th>
<th>Actor</th>
<th>Action</th>
<th>Record</th>
</tr>
</thead>
<tbody>
<% for(const log of logs){ %>
<tr>
<td>
<%= log.created_at %>
</td>
<td>
<%= log.actor %>
</td>
<td>
<%= log.action %>
</td>
<td>
<%= log.entity %> <%= log.entity_id %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
</section>

<% if(typeof uncertainFills!=='undefined'){ %><section class="card"><h2>Uncertain quote deliveries</h2><p>Check Word version history, Commercial and shared Sent Items before reconciling. No retry or email is sent by this form. Wait at least two minutes.</p>
<% for(const f of uncertainFills){ %><form method="post" action="/admin/quote-reconcile"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="fill_id" value="<%= f.id %>"><p>Fill <%= f.id %> / quote <%= f.quote_id %> / <%= f.client_id %></p><label>Verification note<textarea name="note" minlength="10" required></textarea></label><label><input type="checkbox" name="confirm_checked" value="yes" required>I checked the Word versions and Commercial folder</label><button>Release uncertain fill for a new explicit fill</button></form><% } %>
<% for(const a of uncertainSends){ %><article><p>Send attempt <%= a.id %> / quote <%= a.quote_id %> / <%= a.client_id %> / <%= a.phase %></p><% if(a.phase==='Email'&&a.pdf_item_id){ %><form method="post" action="/admin/quote-reconcile"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="attempt_id" value="<%= a.id %>"><label>Verified result<select name="decision"><option value="">Choose</option><option value="not_sent">Email definitely absent; permit explicit email-only retry</option><option value="sent">Email is present in shared Sent Items; record Sent</option></select></label><label>Verification note<textarea name="note" minlength="10" required></textarea></label><label><input type="checkbox" name="confirm_checked" value="yes" required>I checked shared Sent Items and the saved PDF</label><button>Reconcile without sending</button></form><% }else{ %><p>PDF creation is uncertain. Verify the exact PDF item and bytes before database reconciliation; no automatic retry is available.</p><% } %></article><% } %></section><% } %>

<%- include('footer') %>
