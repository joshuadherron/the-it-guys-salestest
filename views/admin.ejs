<%- include('header') %>
<h1>Owner administration</h1>
<p class="muted">Select a section heading to expand its settings. User Permissions &amp; Access controls account roles and privileges.</p>
<details class="card admin-block"><summary>SharePoint connection</summary>
<p>Last checked: <%= schema.checkedAt||'Not checked' %>
</p>
<% for(const error of schema.errors){ %>
<p class="error">
<%= error %>
</p>
<% } for(const issue of [...new Set([...Object.values(schema.actionErrors||{}).flat(),...schema.workErrors||[],...schema.definitionErrors||[]])]){ %><p class="error"><%= issue %> Other handoff actions remain available.</p><% }if(!schema.errors.length){ %>
<p>Core handoff columns and choices are present.</p>
<% } %>
<form method="post" action="/admin/check">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button>Check SharePoint connection</button>
</form>
<details>
<summary>Resolved schema and exact choice values</summary>
<pre>
<%= JSON.stringify(schema,null,2) %>
</pre>
</details>
</details>
<details class="card admin-block"><summary>Sales Prospects sync</summary>
<p>Prospects in Sales App: <strong><%= prospectCount %></strong></p>
<p>Automatic prospect sync is <strong><%= prospectSyncEnabled?'enabled':'disabled' %></strong>.</p>
<% if(prospectSyncSummary.length){ %>
<p>Request history:
<% for(const row of prospectSyncSummary){ %>
<span class="pill"><%= row.status %>: <%= row.count %></span>
<% } %>
</p>
<% } %>
<form method="post" action="/admin/prospect-backfill">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button <%= prospectSyncEnabled?'':'disabled' %>>Backfill all prospects to SharePoint</button>
</form>
<% if(!prospectSyncEnabled){ %>
<p class="muted">Create the Sales Prospects list and Upsert Prospect Power Automate handler first, then set PROSPECT_SYNC_ENABLED=true.</p>
<% } %>
</details>
<details class="card admin-block"><summary>Prices & included amounts</summary>
<p>Changing prices returns approved worksheets to Draft for review.</p>
<% for(const price of prices){ %>
<form method="post" action="/admin/prices" class="row">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="name" value="<%= price.name %>">
<label>
<%= price.name %>
<input name="amount" type="number" min="0" step="0.01" value="<%= price.amount %>" required>
</label>
<button>Save</button>
</form>
<% } %>
</details>
<details class="card admin-block"><summary>Pipeline stage order</summary>
<% for(const stage of stages){ %>
<form method="post" action="/admin/stages" class="row">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="name" value="<%= stage.name %>">
<label>
<%= stage.name %>
<%= stage.managed_only?' — Managed IT only':'' %>
<input type="number" min="0" name="sort_order" value="<%= stage.sort_order %>">
</label>
<button>Save order</button>
</form>
<% } %>
</details>
<details class="card admin-block"><summary>Mark Lost reasons</summary>
<p>Flow-approved text is fixed. Enable reasons and set their display order.</p>
<% for(const reason of lostReasons){ %>
<form method="post" action="/admin/lost-reasons">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="reason" value="<%= reason.reason %>">
<strong><%= reason.reason %></strong>
<label>Order <input type="number" name="sort_order" min="0" value="<%= reason.sort_order %>" required></label>
<label><input type="checkbox" name="enabled" value="yes" <%= reason.enabled?'checked':'' %>> Enabled</label>
<button>Save reason</button>
</form>
<% } %>
</details>
<details class="card admin-block"><summary>Pre-quote stop conditions</summary>
<% for(const stop of [...stops,{id:'',label:'',status:'Owner confirmed'}]){ %>
<form method="post" action="/admin/stops">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<input type="hidden" name="id" value="<%= stop.id %>">
<label>
<%= stop.id?'Condition':'Add condition' %>
</label>
<input name="label" value="<%= stop.label %>" required>
<select name="status">
<% for(const state of ['TODO-OWNER','Owner confirmed']){ %>
<option <%= state===stop.status?'selected':'' %>>
<%= state %>
</option>
<% } %>
</select>
<button>Save condition</button>
</form>
<% } %>
</details>
<details class="card admin-block admin-users"><summary>User Permissions &amp; Access</summary>
<p class="muted">Manage who can sign in, approve quotes, send quotes, and access administration. Each user is saved separately.</p>
<% for(const entry of [...allowlist,{email:'',role:'sales',enabled:true}]){ const isNew=!entry.email; %>
<form method="post" action="/admin/allowlist" class="admin-user-card">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="admin-user-heading">
<div><strong><%= isNew?'Add a user':(entry.display_name||entry.email) %></strong><% if(!isNew&&entry.display_name){ %><span class="muted admin-user-email"><%= entry.email %></span><% } %></div>
<span class="admin-user-role"><%= isNew?'New user':entry.role==='owner'?'Owner':'Sales' %></span>
</div>
<div class="admin-user-fields">
<label>Email address<input name="email" type="email" value="<%= entry.email %>" placeholder="name@theitguys.us" required></label>
<label>Account role<select name="role"><option value="sales" <%= entry.role==='sales'?'selected':'' %>>Sales</option><option value="owner" <%= entry.role==='owner'?'selected':'' %>>Owner</option></select></label>
</div>
<fieldset class="admin-user-permissions"><legend>Account permissions</legend>
<label><input type="checkbox" name="enabled" value="yes" <%= entry.enabled?'checked':'' %>> <span><strong>Enabled</strong><small>Allow this user to sign in</small></span></label>
<label><input type="checkbox" name="is_admin" value="yes" <%= entry.is_admin?'checked':'' %>> <span><strong>Administrator</strong><small>Access the administration screen</small></span></label>
<label><input type="checkbox" name="quote_approve" value="yes" <%= entry.quote_approve?'checked':'' %>> <span><strong>Approve quotes</strong><small>Authorize quote approval</small></span></label>
<label><input type="checkbox" name="quote_send" value="yes" <%= entry.quote_send?'checked':'' %>> <span><strong>Send quotes</strong><small>Permission to send approved quotes</small></span></label>
</fieldset>
<fieldset class="admin-user-sender"><legend>Quote sender details</legend>
<div class="admin-user-fields">
<label>Display name<input name="display_name" maxlength="200" value="<%= entry.display_name||'' %>" placeholder="Full name"></label>
<label>Job title<input name="sender_title" maxlength="200" value="<%= entry.sender_title||'' %>" placeholder="Client Relations"></label>
<label>Phone number<input name="sender_phone" maxlength="80" value="<%= entry.sender_phone||'' %>" placeholder="Business phone"></label>
</div>
</fieldset>
<div class="admin-user-actions"><button type="submit"><%= isNew?'Add user':'Save changes' %></button></div>
</form>
<% } %>
</details>
<% if(typeof quoteEmail!=='undefined'){ %><details class="card admin-block"><summary>Shared-mailbox quote email</summary><p>QUOTE_SENDER_MAILBOX: <%= quoteMailbox %>. This must be a dedicated shared mailbox, never workflow@ or a person's mailbox.</p><form method="post" action="/admin/quote-email"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Subject template<input name="subject_template" maxlength="250" value="<%= quoteEmail.subject_template %>" required></label><label>Body template<textarea name="body_template" maxlength="12000" rows="8" required><%= quoteEmail.body_template %></textarea></label><p>Tokens: {QuoteId}, {FirstName}, {MonthlyTotal}, {Onboarding}, {BAA phrase}, {SenderName}, {SenderTitle}, {SenderPhone}</p><button>Save quote email template</button></form></details><% } %>
<details class="card admin-block"><summary>Audit log — latest 200 events</summary>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>When</th>
<th>Actor</th>
<th>Action</th>
<th>Record</th>
</tr>
</thead>
<tbody>
<% for(const log of logs){ %>
<tr>
<td>
<%= log.created_at %>
</td>
<td>
<%= log.actor %>
</td>
<td>
<%= log.action %>
</td>
<td>
<%= log.entity %> <%= log.entity_id %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
</details>

<% if(typeof uncertainFills!=='undefined'){ %><details class="card admin-block"><summary>Uncertain quote deliveries</summary><p>Check Word version history, Commercial and shared Sent Items before reconciling. No retry or email is sent by this form. Wait at least two minutes.</p>
<% for(const f of uncertainFills){ %><form method="post" action="/admin/quote-reconcile"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="fill_id" value="<%= f.id %>"><p>Fill <%= f.id %> / quote <%= f.quote_id %> / <%= f.client_id %></p><label>Verification note<textarea name="note" minlength="10" required></textarea></label><label><input type="checkbox" name="confirm_checked" value="yes" required>I checked the Word versions and Commercial folder</label><button>Release uncertain fill for a new explicit fill</button></form><% } %>
<% for(const a of uncertainSends){ %><article><p>Send attempt <%= a.id %> / quote <%= a.quote_id %> / <%= a.client_id %> / <%= a.phase %></p><% if(a.phase==='Email'&&a.pdf_item_id){ %><form method="post" action="/admin/quote-reconcile"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="attempt_id" value="<%= a.id %>"><label>Verified result<select name="decision"><option value="">Choose</option><option value="not_sent">Email definitely absent; permit explicit email-only retry</option><option value="sent">Email is present in shared Sent Items; record Sent</option></select></label><label>Verification note<textarea name="note" minlength="10" required></textarea></label><label><input type="checkbox" name="confirm_checked" value="yes" required>I checked shared Sent Items and the saved PDF</label><button>Reconcile without sending</button></form><% }else{ %><p>PDF creation is uncertain. Verify the exact PDF item and bytes before database reconciliation; no automatic retry is available.</p><% } %></article><% } %></details><% } %>

<%- include('footer') %>
