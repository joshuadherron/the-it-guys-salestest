<%- include('header') %><h1>Quote · <%= q.quote_number||q.id %></h1><p><%= p.business_name %></p>
<% if(job.status==='WaitingApproval'){ %><h2>Waiting for Josh</h2><p><a class="button" href="/quick-quote/quotes/<%= q.id %>"><%= canApprove?'Review → Approve & Send':'View preview' %></a></p>
<% }else if(job.status==='ReadySignature'){ %><h2>Ready for signature</h2><p>BII uses Microsoft 365 eSignature.</p>
<% for(const item of [...documents.quote,...documents.psa]){ %><p><strong><%= item.document||item.workflowId %></strong> <% if(item.url&&/^https:\/\//i.test(item.url)){ %><a href="<%= item.url %>" target="_blank" rel="noopener noreferrer">Open in SharePoint to request signature</a><% }else{ %>SharePoint link unavailable; check this client’s Client Operations record.<% } %></p><% } %>
<% if(documents.psaSigned){ %><p>A signed PSA is already recorded.</p><% }else if(documents.psaMissing){ %><p class="error">No PSA copy is available. Ask Josh to check the Quoting / Start Stage definitions in SharePoint before requesting signatures. This app does not create a PSA through an unverified flow.</p><% } %>
<form method="post" action="/quick-quote/quotes/<%= q.id %>/signature-sent"><input name="_csrf" type="hidden" value="<%= csrf %>"><label><input name="confirm" type="checkbox" value="yes" required>I actually sent the required eSignature requests.</label><button>Mark sent for signature</button></form>
<% }else if(['Sent','Dryrun'].includes(job.status)){ %><h2><%= job.status==='Sent'?'Sent':'Test email sent' %></h2><% if(job.status==='Dryrun'){ %><p>Dryrun emailed the internal sender only; nothing was sent to the client.</p><% } %>
<% }else if(job.status==='Failed'){ %><h2>Send needs attention</h2><p class="error"><%= job.error_message %></p><p><a href="/quick-quote/quotes/<%= q.id %>">Return to quote</a> · <a href="/prospects/<%= p.id %>/handoff">Request history / reconciliation</a> · <a href="/quotes/<%= q.id %>/delivery">Email delivery reconciliation</a></p>
<form method="post" action="/quick-quote/quotes/<%= q.id %>/resume"><input name="_csrf" type="hidden" value="<%= csrf %>"><button>Resume after resolving the issue</button><p>Email attempts require separate delivery reconciliation and are never replayed by Resume.</p></form>
<% }else{ %><p id="quick-progress" role="status">Setting up client folder…</p><p id="quick-error" class="error" role="alert"></p>
<form id="quick-progress-form" action="/quick-quote/quotes/<%= q.id %>/progress" method="post"><input name="_csrf" type="hidden" value="<%= csrf %>"></form>
<div id="quick-reconcile" hidden><p>No exact request title match was found after ten minutes. Only Josh may confirm absence after checking SharePoint.</p><% if(user.role==='owner'){ %><form id="quick-confirm-absent" method="post"><input name="_csrf" type="hidden" value="<%= csrf %>"><label>Reconciliation note<textarea name="note" required></textarea></label><label><input name="confirm_absent" type="checkbox" value="yes" required>I checked SharePoint and confirmed the exact request title is absent.</label><button>Confirm absence after checking</button></form><% }else{ %><p>Ask Josh to open this quote and check the request.</p><% } %></div>
<p>You can leave this page. Opening this quote resumes its saved Send process automatically.</p><script src="/quick-quote.js" defer></script><% } %>
<p><a href="/quick-quote/quotes/<%= q.id %>">Return to quote</a> · <a href="/prospects/<%= p.id %>/handoff">Request history</a> · <a href="/prospects/<%= p.id %>/work">Return to business</a></p><%- include('footer') %>
