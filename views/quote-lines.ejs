<table>
<thead>
<tr>
<th>Item</th>
<th>Qty</th>
<th>Unit</th>
<th>Amount</th>
</tr>
</thead>
<tbody>
<% for(const line of lines){ %>
<tr>
<td>
<%= line.label %>
</td>
<td>
<%= line.quantity %>
</td>
<td>$<%= Number(line.unit).toFixed(2) %>
</td>
<td>$<%= Number(line.amount).toFixed(2) %>
</td>
</tr>
<% } %>
</tbody>
</table>
<h2>Total: $<%= Number(total).toFixed(2) %>
</h2>
<p>Hardware: Quoted separately</p>