<%- include('header') %><p><a href="/businesses/<%= p.business_id %>">All opportunities for this business</a> · <a href="/pipeline">Pipeline</a></p><h1><%= p.business_name %> — <%= p.opportunity_title||engagementTypes[p.engagement_type] %></h1>
<p><%= p.opp %> · <%= engagementTypes[p.engagement_type] %> · <%= p.stage %> · <%= p.business_relationship_status||'Prospect' %></p>
<p>This work does not enroll the business in Managed IT, monitoring, security or backups.</p><% if(p.hold){ %><p class="hold">On Hold — Pending Josh Review</p><% } %>
<% if(user.is_admin){ %><p><a href="/prospects/<%= p.id %>/delete">Delete opportunity</a></p><% } %>
<%- include('sales-actions') %><%- include('sales-outcome') %>
<section class="card"><h2>Intake</h2><p><%= intake?.complete?'Complete':'Draft' %></p><% if(missing.length){ %><p>Recommended sales context; required before work authorization:</p><ul><% for(const item of missing){ %><li><a href="<%= item.href %>"><%= item.label %></a></li><% } %></ul><% } %><% for(const flag of flags){ %><p class="<%= flag.urgent?'hold':'pill' %>"><%= flag.label %> · Review before authorizing work</p><% } %></section>
<section class="card"><h2>Sales outcome and handoff</h2>
<% if(handoff){ %><p>Won — customer authorization recorded.</p><p><%= handoff.authorization_kind %>: <%= handoff.authorization_reference %></p><p>Quote <%= handoff.quote_number||handoff.quote_id %> · recorded by <%= handoff.actor %></p><p>Hand off to: <%= handoff.handoff_destination %></p><p><%= handoff.handoff_notes||'' %></p><p>Continue delivery in the existing delivery system.</p>
<% }else{ %><p>Internal quote approval does not authorize work. Record the customer's acceptance and the sales handoff separately.</p>
<% if(canSend){ %><form method="post" action="/prospects/<%= p.id %>/authorize"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Approved quote<select name="quote_id" required><option value="">Choose…</option><% for(const q of quotes.filter(q=>['Approved','Sent'].includes(q.status))){ %><option value="<%= q.id %>"><%= q.quote_number||q.id %> · $<%= Number(q.total).toFixed(2) %></option><% } %></select></label><label>Authorization received<select name="authorization_kind"><% for(const kind of ['Written acceptance','Signed statement of work','Purchase order','Rate authorization']){ %><option><%= kind %></option><% } %></select></label><label>Acceptance evidence / reference<textarea name="authorization_reference" minlength="10" maxlength="2000" required></textarea></label><label>Handoff destination / reference<input name="handoff_destination" maxlength="200" placeholder="MSP Manager or existing delivery system"></label><label>Sales handoff notes<textarea name="handoff_notes" maxlength="2000"></textarea></label><label><input type="checkbox" name="confirm" value="yes" required>I received the customer's authorization for this scope and estimate.</label><button>Record acceptance and handoff / Mark won</button></form><% } %><% } %></section>
<section class="card" id="sales-notes"><h2>Notes and activity</h2><form method="post" action="/prospects/<%= p.id %>/activities"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="type" value="note"><input type="hidden" name="outcome" value="Other"><label>Notes<textarea name="notes" maxlength="10000" required></textarea></label><button>Add note</button></form><% if(typeof activities!=='undefined'){ for(const a of activities){ %><p><strong><%= a.occurred_on %> · <%= a.outcome %></strong><br><%= a.notes %></p><% }} %></section><%- include('footer') %>
