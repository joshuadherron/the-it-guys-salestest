<%- include('header') %><%- include('sales-notices') %><h1><%= engagementTypes[p.engagement_type] %> quotes</h1><p><a href="/prospects/<%= p.id %>/work"><%= p.business_name %> · <%= p.opp %></a></p>
<p>Estimates are not invoices. Custom prices require quote approval. Recurring line items apply only when explicitly included and do not grant Managed IT coverage.</p>
<% if(p.hold){ %><p class="hold">On Hold — Pending Josh Review</p><% } %><% if(!intakeComplete||missing.length){ %><p>Intake is incomplete. You can prepare and approve pricing now; complete intake before authorizing work. <a href="/prospects/<%= p.id %>/intake">Review intake</a></p><ul><% for(const item of missing){ %><li><a href="<%= item.href %>"><%= item.label %></a></li><% } %></ul><% } %>
<section class="card"><h2>Quote history</h2><% for(const q of quotes){ %><p><a href="?quote=<%= q.id %>"><%= q.quote_number||q.id %></a> · <%= q.status %> · $<%= Number(q.total).toFixed(2) %> · <a href="/quotes/<%= q.id %>/project-print">Printable estimate / quote</a><% if(canSend&&q.status==='Approved'){ %> · <a href="/quotes/<%= q.id %>/document">Prepare approved SharePoint proposal</a><% } %></p><% } %></section>
<% if(selected){ %><section class="card"><h2><%= selected.quote_number||selected.id %> · <%= selected.status %></h2><p><%= input.scope %></p><table><thead><tr><th>Item</th><th>Qty</th><th>Unit price</th><th>Billing</th><th>Amount</th></tr></thead><tbody><% for(const l of json(selected.line_items)){ %><tr><td><%= l.label %></td><td><%= l.quantity %></td><td>$<%= Number(l.unitPrice??l.amount).toFixed(2) %></td><td><%= l.billing %></td><td>$<%= Number(l.amount).toFixed(2) %></td></tr><% } %></tbody></table><p><%= input.terms %></p>
<% if(canApprove&&selected.status==='Draft'){ %><form method="post" action="/quotes/<%= selected.id %>/project-approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><input type="checkbox" name="reviewed" value="yes" required>I reviewed scope, custom pricing, risks and authorization terms. Approval does not authorize work.</label><button>Approve quote snapshot</button></form><% } %>
<% if(canSend&&selected.status==='Approved'){ %><form method="post" action="/quotes/<%= selected.id %>/project-sent"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><input type="checkbox" name="confirm" value="yes" required>I actually sent this approved proposal to the customer. No email is sent by this button.</label><button>Record proposal sent manually</button></form><% } %></section><% } %>
<form method="post" action="/prospects/<%= p.id %>/project-quotes" class="card" data-project-quote><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(selected){ %><input type="hidden" name="revise_id" value="<%= selected.id %>"><% } %><h2><%= selected?'Create a new draft revision':'New draft quote / estimate' %></h2><p>Saving preserves existing quotes and approvals.</p>
<label>Scope<textarea name="scope" maxlength="10000" required><%= input?.scope||'' %></textarea></label><label>Pricing basis<select name="basis"><option value="estimate">Estimate</option><% if(p.engagement_type==='project'){ %><option value="fixed" <%= input?.basis==='fixed'?'selected':'' %>>Fixed-price scope</option><% } %></select></label>
<% if(p.engagement_type==='hourly'){ %><div class="grid"><label>Estimated hours<input name="estimatedHours" type="number" min="0.01" step="0.01" required value="<%= input?.estimatedHours||'' %>"></label><label>Proposed hourly rate<input name="hourlyRate" type="number" min="0.01" step="0.01" required value="<%= input?.hourlyRate??config.hourly_rate??'' %>"></label></div><p>Configured minimum: <%= config.minimum_hours %> hours. Actual authorized time and materials determine billing; this estimate is not a final bill.</p><% } %>
<div class="table-scroll"><table><thead><tr><th>Description</th><th>Kind</th><th>Qty</th><th>Unit price</th><th>Billing</th></tr></thead><tbody data-quote-lines><% const items=input?.lines?.length?input.lines:[{}, {}, {}, {}]; for(const [i,l] of items.entries()){ %><tr><td><input name="line_label" value="<%= l.label||'' %>" maxlength="1000" aria-label="Line description"></td><td><select name="line_kind"><% for(const kind of ['labor','materials','equipment','deliverable','other']){ %><option <%= l.kind===kind?'selected':'' %>><%= kind %></option><% } %></select></td><td><input name="line_quantity" type="number" min="0.001" step="0.001" value="<%= l.quantity??1 %>" aria-label="Quantity"></td><td><input name="line_unitPrice" type="number" min="0" step="0.01" value="<%= l.unitPrice??0 %>" aria-label="Unit price"></td><td><select name="line_billing"><option value="one_time">One-time</option><option value="monthly" <%= l.billing==='monthly'?'selected':'' %>>Monthly</option></select></td></tr><% } %></tbody></table></div><button type="button" data-add-quote-line>Add item</button>
<label><input type="checkbox" name="confirm_recurring" value="yes">I explicitly included and described any monthly charges.</label>
<label>Exclusions<textarea name="exclusions" maxlength="10000"><%= input?.exclusions||'' %></textarea></label><label>Assumptions / dependencies<textarea name="assumptions" maxlength="10000"><%= input?.assumptions||'' %></textarea></label><label>Estimate / authorization terms for owner approval<textarea name="terms" maxlength="10000" required><%= input?.terms||'' %></textarea></label><button>Save draft for review</button></form><script src="/project-quotes.js" defer></script><%- include('footer') %>
