<%- include('header') %>

<p>
  <a href="/prospects/<%= p.id %>">
    <%= p.opp %> · <%= p.business_name %>
  </a>
</p>

<h1>SharePoint actions &amp; history</h1>
<p>Opportunity type: <strong><%= p.engagement_type==='managed_it'?'Managed IT':'BII / Standardization' %></strong>. <a href="/prospects/<%= p.id %>/edit">Review / correct opportunity type</a></p>
<a href="/prospects/<%= p.id %>">Back to prospect</a>

<p>
  Requests go only to Workflow Requests.
  Power Automate owns the client and document workflow.
</p>

<% if (error) { %>
  <p class="error">
    <%= error %>
  </p>
<% } %>

<% if (p.hold) { %>
  <div class="hold">On Hold — Pending Josh Review</div>
<% } %>

<% for (const schemaError of schema.errors) { %>
  <p class="error">
    <%= schemaError %>
  </p>
<% } %>

<section class="card" data-client-status="<%= p.id %>">
  <h2>SharePoint record status</h2>

  <% if (clientRecord) { %>
    <% for (const [name, value] of Object.entries(clientRecord)) { %>
      <p>
        <strong><%= name %>:</strong>
        <%= value %>
      </p>
    <% } %>
  <% } else { %>
    <p>No linked SharePoint record yet.</p>
  <% } %>
</section>

<% if(!clientRecord&&!p.client_id&&p.relationship_type!=='existing_client'){ %>
<section class="card">
  <h2>Open SharePoint record</h2>
  <p>Creates the opportunity's SharePoint folder and tracking row so proposals can be stored. This does not make them a client.</p>

  <p>
    Quick Quote prepares proposal records automatically. These governed service actions retain their own readiness checks.
  </p>

  <form method="post" action="/prospects/<%= p.id %>/handoff">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="action" value="CreateClient">
    <% if(typeof duplicates!=='undefined'&&duplicates.length){ %><div class="error"><h3>Possible existing client found</h3><% for(const c of duplicates){ %><p><%= c.Title %> - <%= c['Client ID'] %> - <%= c['Service Lanes'] %></p><% } %><a href="/prospects/<%= p.id %>/relationship">Use existing client (Josh)</a><label><input type="checkbox" name="confirm_different" value="yes" required>This is a different company</label></div><% } %>

    <fieldset><legend>Services being considered</legend>
    <p>Choose both when this opportunity includes a BII project and ongoing Managed IT.</p>
    <% for (const lane of [...lanes, 'BII + Managed IT']) { %>
      <label>
        <input
          type="radio"
          name="service_scope"
          value="<%= lane %>"
          <%= typeof servicePlan!=='undefined'&&servicePlan.scope===lane?'checked':'' %>
          required
        >
        <%= lane %>
      </label>
    <% } %>
    </fieldset>
    <div class="card">
      <h3>Project or hourly work</h3>
      <p>For one-time projects or break-fix work, choose the opportunity type first. After saving, SharePoint uses the Business Technology Projects lane automatically.</p>
      <p><a class="button secondary" href="/prospects/<%= p.id %>/edit?engagement_type=project&amp;next=sharepoint#opportunity-type">Project / One-Time work</a>
      <a class="button secondary" href="/prospects/<%= p.id %>/edit?engagement_type=hourly&amp;next=sharepoint#opportunity-type">Hourly / Break-Fix</a></p>
      <p>Josh must save type corrections.<% if(p.business_id){ %> If this is additional work alongside an existing MIT/BII sale, <a href="/prospects/new?business_id=<%= p.business_id %>&amp;engagement_type=project">open a Project opportunity under this business</a>.<% } %></p>
    </div>
    <fieldset data-service-sequence hidden><legend>Which workflow starts first?</legend>
      <p>BII first is preferred. When timing requires Managed IT first, Josh records the reason. Both services stay in the opportunity plan; this starts one workflow.</p>
      <label>Starting workflow<select name="starting_service_lane" <%= user.role!=='owner'?'disabled':'' %>>
        <option value="Business IT Integration">BII first (preferred)</option>
        <option value="Managed IT" <%= typeof servicePlan!=='undefined'&&servicePlan.scope==='BII + Managed IT'&&servicePlan.startingLane==='Managed IT'?'selected':'' %>>Managed IT first (timing exception)</option>
      </select></label>
      <label data-sequence-reason hidden>Why must Managed IT start first?<textarea name="service_sequence_reason" maxlength="1000" minlength="10"><%= typeof servicePlan!=='undefined'?servicePlan.reason:'' %></textarea></label>
      <% if(user.role!=='owner'){ %><p>Josh can choose Managed IT first when needed. BII first is the default for both services.</p><% } %>
    </fieldset>

    <button
      <%= !ready || nameError ||
          missing.length ||
          p.client_id
          ? 'disabled'
          : '' %>
    >
      Open SharePoint record
    </button>
    <p>The discovery is copied to SharePoint when the client is created. Later edits stay in the app.</p>
    <% if(nameError){ %><p class="error"><%= nameError %></p><% } %>
  </form>
</section>

<script src="/service-plan.js" defer></script>

<% }else{ %><section class="card"><h2>Existing SharePoint Client</h2><p><%= p.business_name %> - <%= p.client_id %></p><p>New service being sold: <%= p.service_lane %></p><a href="/prospects/<%= p.id %>/additional-discovery">Additional Service Discovery</a><% if(typeof transitionError!=='undefined'&&transitionError){ %><p class="error"><%= transitionError %></p><% } %></section><% } %>
<% if (user.role === 'owner') { %>
  <section class="card">
    <h2>Next workflow stage</h2>

    <% for (const [action, label, lane] of [
      ['Quoting', 'Send to Quoting', 'Business IT Integration'],
      ['TechnicalAssessment', 'Start Technical Assessment', 'Managed IT']
    ].filter(([action])=>p.relationship_type!=='existing_client'||action==='TechnicalAssessment')) { %>

      <form method="post" action="/prospects/<%= p.id %>/handoff">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="<%= action %>">

        <button
          <%= !ready || (p.relationship_type==='existing_client'&&typeof transitionError!=='undefined'&&transitionError) ||
              !p.client_id ||
              (action === 'Quoting' && (p.service_lane !== lane || !approved)) ||
              (action === 'TechnicalAssessment' &&
                p.service_lane !== 'Managed IT' &&
                expectedStage !== 'Acceptance')
              ? 'disabled'
              : '' %>
        >
          <%= p.relationship_type==='existing_client'&&action==='TechnicalAssessment'?'Start Managed IT Transition':label %>
        </button>
      </form>

    <% } %>

    <% if(p.client_id){ %>
      <h2>Mark Lost</h2>
      <% if(!canMarkLost){ %>
        <p>Mark Lost is unavailable at this client stage. Clients at Client Activation or later must use Start Offboarding in SharePoint. If the stage is unavailable, refresh the connection first.</p>
      <% }else{ %>
        <form method="post" action="/prospects/<%= p.id %>/mark-lost">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="expectedStage" value="<%= expectedStage %>">
          <label>Reason
            <select name="reason" required><option value="">Choose…</option>
              <% for(const r of lostReasons){ %><option><%= r.reason %></option><% } %>
            </select>
          </label>
          <label>Notes (optional, up to 500 characters)<textarea name="notes" maxlength="500"></textarea></label>
          <button <%= !ready || !lostReasons.length || schema.actionErrors?.MarkLost?.length ? 'disabled' : '' %>>Mark Lost</button>
        </form>
      <% } %>
      <% for(const issue of schema.actionErrors?.MarkLost || []){ %><p class="error"><%= issue %></p><% } %>
    <% } %>
  </section>
<% } %>

<section class="card">
  <h2>Request history</h2>

  <p>
    Live status refreshes every 30 seconds while this page is open.
    Requests are never automatically resubmitted.
  </p>

  <% for (const r of requests) { %>
    <article class="card" data-request="<%= r.id %>">
      <h3>
        <%= r.action %> ·
        <span class="request-status">
          <%= r.status %>
        </span>
      </h3>

      <p class="request-plain">
        <%= plainResult(r.status) %>
      </p>

      <p>
        SharePoint item:
        <%= r.item_id || 'Not created' %>
      </p>

      <% if(r.status==='Rejected'){ %><p class="error preserve-lines"><%= r.result_message %></p><% } %>
      <% if(r.target_item_id){ %><p>Document item <%= r.target_item_id %></p><% } %>
      <details>
        <summary>Raw result</summary>
        <pre class="request-raw"><%= r.result_message || '' %></pre>
      </details>

      <% if (
        user.role === 'owner' &&
        ['Unknown', 'Preparing'].includes(r.status)
      ) { %>

        <form method="post" action="/requests/<%= r.id %>/reconcile">
          <input type="hidden" name="_csrf" value="<%= csrf %>">

          <label>Reconciliation note</label>
          <textarea name="note" required></textarea>

          <label>
            <input
              type="checkbox"
              name="confirm_absent"
              value="yes"
            >
            If no exact-title match is found, I confirm no request was created
            and allow an explicit retry.
          </label>

          <button>Reconcile with SharePoint</button>
        </form>

      <% } %>

      <details>
        <summary>Exact request JSON</summary>
        <pre><%= JSON.stringify(json(r.request_json), null, 2) %></pre>
      </details>
    </article>
  <% } %>
</section>

<%- include('footer') %>
