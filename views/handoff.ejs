<%- include('header') %><p><a href="/prospects/<%= p.id %>"><%= p.opp %> · <%= p.business_name %></a></p><h1>SharePoint handoff</h1><p>Requests go only to Workflow Requests. Power Automate owns the client and document workflow.</p><% if(error){ %><p class="error"><%= error %></p><% }if(p.hold){ %><div class="hold">On Hold — Pending Josh Review</div><% }for(const error of schema.errors){ %><p class="error"><%= error %></p><% } %><section class="card" data-client-status="<%= p.id %>"><h2>Client status</h2><% if(client){for(const [name,v] of Object.entries(client)){ %><p><strong><%= name %>:</strong> <%= v %></p><% }}else{ %><p>No linked SharePoint client yet.</p><% } %></section><section class="card"><h2>Create client in SharePoint</h2><p>Requires Qualified or later and completed discovery. Missing groups: <%= missing.join(', ')||'none' %>.</p><form method="post" action="/prospects/<%= p.id %>/handoff"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="CreateClient"><% for(const lane of lanes){ %><label><input type="radio" name="service_lane" value="<%= lane %>" required> <%= lane %></label><% } %><button <%= !ready||missing.length||p.client_id||!['Qualified','Discovery','Proposal Sent','Closed Won','Technical Assessment'].includes(p.stage)?'disabled':'' %>>Create client in SharePoint</button></form></section><% if(user.role==='owner'){ %><section class="card"><h2>Next workflow stage</h2><% for(const [action,label,lane] of [['Quoting','Send to Quoting','Business IT Integration'],['TechnicalAssessment','Start Technical Assessment','Managed IT']]){ %><form method="post" action="/prospects/<%= p.id %>/handoff"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= action %>"><button <%= !ready||!p.client_id||p.service_lane!==lane||(action==='Quoting'&&!approved)?'disabled':'' %>><%= label %></button></form><% } %><p><button disabled>Mark Lost</button> Disabled pending exact payload confirmation.</p></section><% } %><section class="card"><h2>Request history</h2><p>Live status refreshes every 30 seconds while this page is open. Requests are never automatically resubmitted.</p><% for(const r of requests){ %><article class="card" data-request="<%= r.id %>"><h3><%= r.action %> · <span class="request-status"><%= r.status %></span></h3><p class="request-plain"><%= plainResult(r.status) %></p><p>SharePoint item: <%= r.item_id||'Not created' %></p><details><summary>Raw result</summary><pre class="request-raw"><%= r.result_message||'' %></pre></details><details><summary>Exact request JSON</summary><pre><%= JSON.stringify(json(r.request_json),null,2) %></pre></details></article><% } %></section><%- include('footer') %>