<%- include('header') %>
<h1><%= p.id?'Edit opportunity':'Add prospect' %></h1>
<p><%= p.id?'Update this opportunity’s details.':'Enter a business name to save a new prospect. Add contact details now if you have them; everything else can wait.' %></p>
<form method="post" action="/prospects<%= p.id?'/'+p.id:'' %>" class="card">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<% if(p.id&&p.engagement_type){ %><input type="hidden" name="original_engagement_type" value="<%= p.engagement_type %>"><% } %>
<% if(p.id&&typeof returnToSharePoint!=='undefined'&&returnToSharePoint){ %><input type="hidden" name="next" value="sharepoint"><% } %>
<% if(!p.id){ %><%- include('business-choice',{p,businesses:typeof businesses==='undefined'?[]:businesses}) %><% }else if(p.business_id){ %><p><a href="/businesses/<%= p.business_id %>">All opportunities for this business</a></p><% } %>
<% if(!p.id){ %><details><summary>Opportunity details (optional)</summary><% } %>
<fieldset><legend>Opportunity</legend>
<label for="opportunity-type">Engagement type</label><select id="opportunity-type" name="engagement_type"><% for(const [key,label] of Object.entries(engagementTypes)){ %><option value="<%= key %>" <%= (typeof requestedEngagementType!=='undefined'&&requestedEngagementType||p.engagement_type||'project')===key?'selected':'' %>><%= label %></option><% } %></select>
<% if(p.id&&typeof requestedEngagementType!=='undefined'&&requestedEngagementType&&requestedEngagementType!==p.engagement_type){ %><p>Current saved type: <strong><%= engagementTypes[p.engagement_type] %></strong>. <strong><%= engagementTypes[requestedEngagementType] %></strong> is selected for review. Josh must save this correction before the Project SharePoint path is available; opening this form does not change the opportunity.</p><% } %>
<% if(p.id){ %><p>Josh can correct this type before quoting or starting SharePoint workflows. Existing discovery is archived and the new type's discovery must be reviewed. Security holds remain in place. <a href="/prospects/<%= p.id %>/discovery-history">Discovery history</a></p><% } %>
<label>Opportunity / work title<input name="opportunity_title" maxlength="255" value="<%= p.opportunity_title||'' %>" placeholder="For example: Outlook repair or office network upgrade"></label></fieldset>
<% if(!p.id){ %></details><% } %>

<fieldset>
<legend>Basic business information</legend>
<div class="grid">
<% for(const [key,label] of [
  ['business_name','Business Name'],
  ['contact_name','Contact Name'],
  ['phone','Phone'],
  ['email','Email'],
  ...(p.id?locationFields:[])
]){ %>
<div>
<label for="<%= key %>"><%= label %></label>
<input
  id="<%= key %>"
  name="<%= key %>"
  value="<%= p[key]??'' %>"
  type="<%= key==='email'?'email':key==='phone'?'tel':'text' %>"
  <%= key==='business_name'?'required':'' %>
  <%= key==='zip'?'inputmode="numeric" autocomplete="postal-code" maxlength="10"':'' %>
  <%= key==='street_address'?'autocomplete="street-address"':'' %>
  <%= key==='city'?'autocomplete="address-level2"':'' %>
  <%= key==='state'?'autocomplete="address-level1"':'' %>
>
</div>
<% } %>
</div>
<p class="muted" id="zip-lookup-status" aria-live="polite"></p>
</fieldset>

<% if(!p.id){ %><details><summary>More details (optional)</summary><fieldset><legend>Address</legend><div class="grid"><% for(const [key,label] of locationFields){ %><label><%= label %><input id="<%= key %>" name="<%= key %>" value="<%= p[key]||'' %>"></label><% } %></div></fieldset><% } %>
<fieldset>
<legend>Additional prospect information</legend>
<div class="grid">
<% for(const [key,label] of fields.slice(4)){ %>
<div>
<label for="<%= key %>">
<%= label %>
<%= key==='likely_service'?' — signal for Josh, not a decision':'' %>
</label>
<% const opts=key==='call_frequency'?frequencies:key==='likely_service'?services:key==='stage'?stages.filter(s=>!s.managed_only||p.service_lane==='Managed IT').map(s=>s.name):key==='owner'?owners.map(o=>o.email):null;if(opts){ %>
<select id="<%= key %>" name="<%= key %>">
<% if(key==='likely_service'||key==='call_frequency'){ %><option value="" <%= !p[key]?'selected':'' %>>Unset</option><% } %>
<% for(const option of opts){ %>
<option <%= (p[key]||(key==='stage'?'Prospecting':key==='owner'?'alanna@theitguys.us':''))===option?'selected':'' %>><%= option %></option>
<% } %>
</select>
<% }else if(['notes','current_it','key_dependency'].includes(key)){ %>
<textarea id="<%= key %>" name="<%= key %>"><%= p[key]||'' %></textarea>
<% }else{ %>
<input id="<%= key %>" name="<%= key %>" value="<%= p[key]??'' %>" type="<%= ['first_contact','follow_up'].includes(key)?'date':key==='employee_count'?'number':'text' %>" min="0">
<% } %>
</div>
<% } %>
</div>
</fieldset>

<fieldset>
<legend>Next action, meeting & source status</legend>
<div class="grid">
<% for(const [key,label] of structuredFields){ %>
<div>
<label for="<%= key %>"><%= label %></label>
<% if(['teams_scheduled','josh_needed'].includes(key)){ %>
<select name="<%= key %>" id="<%= key %>"><option value="">Unset</option><option value="true" <%= p[key]===true||p[key]===1?'selected':'' %>>Yes</option><option value="false" <%= p[key]===false||p[key]===0?'selected':'' %>>No</option></select>
<% }else if(key==='status'){ %>
<select name="status" id="status"><option value="">Unset</option><% for(const v of ['Active','Nurture','Lost']){ %><option <%= p.status===v?'selected':'' %>><%= v %></option><% } %></select>
<% }else{ %>
<input name="<%= key %>" id="<%= key %>" value="<%= p[key]??'' %>" type="<%= key.endsWith('_date')?'date':key.endsWith('_time')?'time':['meeting_duration','est_monthly_revenue'].includes(key)?'number':'text' %>" min="0" step="<%= key==='est_monthly_revenue'?'0.01':key.endsWith('_time')?'1':'1' %>">
<% } %>
</div>
<% } %>
</div>
</fieldset>

<% if(!p.id){ %></details><% } %>
<button><%= p.id&&typeof returnToSharePoint!=='undefined'&&returnToSharePoint?'Save and continue to SharePoint':'Save prospect' %></button>
<% if(!p.id&&(user.quote_send===true||user.quote_send===1)){ %><button name="next" value="quote">Save and build a quote</button><% } %>
</form>
<script src="/opportunity-form.js" defer></script>
<%- include('footer') %>
